<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="ScienyxDashboard.uss" />

    <ui:VisualElement name="Root" class="root">

        <ui:VisualElement name="Sidebar" class="sidebar">

            <ui:ScrollView name="Menu" class="menu" vertical-scroller-visibility="Hidden"
                horizontal-scroller-visibility="Hidden">

                <ui:VisualElement name="SidebarHeaderItem" class="sidebar-header-item">
                    <ui:Label name="LogoLabel" class="logo" text="Scienyx" />
                    <ui:Button name="ToggleButton" class="toggle-btn">
                        <ui:VisualElement name="ToggleIcon" class="menu-icon icon-chevron" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- anasayfa -->
                <ui:Button name="HomeBtn" class="menu-item active">
                    <ui:VisualElement name="HomeIcon" class="menu-icon icon-home" />
                    <ui:Label name="HomeLabel" class="menu-text" text="Anasayfa" />
                </ui:Button>

                <!-- kullanıcı yonetimi -->
                <ui:VisualElement name="UserManagementGroup" class="menu-group">
                    <ui:Button name="UserManagementBtn" class="menu-item dropdown-btn">
                        <ui:VisualElement name="UserManagementIcon" class="menu-icon icon-user" />
                        <ui:Label name="UserManagementLabel" class="menu-text"
                            text="Kullanıcı Yönetimi" />
                        <ui:VisualElement name="UserManagementChevron"
                            class="menu-chevron icon-chevron-down" />
                    </ui:Button>
                    <ui:VisualElement name="UserManagementSubMenu" class="sub-menu">
                        <ui:Button name="AddUserBtn" class="sub-menu-item" text="Kullanıcı Ekle" />
                        <ui:Button name="ListUsersBtn" class="sub-menu-item"
                            text="Kullanıcıları Listele" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- rol izin -->
                <ui:VisualElement name="RolePermissionGroup" class="menu-group">
                    <ui:Button name="RolePermissionBtn" class="menu-item dropdown-btn">
                        <ui:VisualElement name="RolePermissionIcon" class="menu-icon icon-roleperm" />
                        <ui:Label name="RolePermissionLabel" class="menu-text"
                            text="Rol/İzin Yönetimi" />
                        <ui:VisualElement name="RolePermissionChevron"
                            class="menu-chevron icon-chevron-down" />
                    </ui:Button>
                    <ui:VisualElement name="RolePermissionSubMenu" class="sub-menu">
                        <ui:Button name="RolesBtn" class="sub-menu-item" text="Roller" />
                        <ui:Button name="PermissionsBtn" class="sub-menu-item" text="İzinler" />
                        <ui:Button name="TeacherRequestsBtn" class="sub-menu-item" text="Öğretmen Olma İstekleri" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- icerik yonetimi -->
                <ui:VisualElement name="ContentManagementGroup" class="menu-group">
                    <ui:Button name="ContentManagementBtn" class="menu-item dropdown-btn">
                        <ui:VisualElement name="ContentManagementIcon" class="menu-icon icon-missions" />
                        <ui:Label name="ContentManagementLabel" class="menu-text"
                            text="İçerik Yönetimi" />
                        <ui:VisualElement name="ContentManagementChevron"
                            class="menu-chevron icon-chevron-down" />
                    </ui:Button>
                    <ui:VisualElement name="ContentManagementSubMenu" class="sub-menu">
                        <ui:Button name="CreatorsBtn" class="sub-menu-item" text="İçerik Üreticileri" />
                        <!--
                        <ui:Button name="TrackCreatorsBtn" class="sub-menu-item" text="Takip" />
                        -->
                        <ui:Button name="MissionsDataBtn" class="sub-menu-item" text="Görev Verileri" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Button name="CalendarBtn" class="menu-item">
                    <ui:VisualElement name="CalendarIcon" class="menu-icon icon-calendar" />
                    <ui:Label name="CalendarLabel" class="menu-text"
                        text="Takvim" />
                </ui:Button>

                <!-- aktivite -->
                <ui:Button name="ActivityBtn" class="menu-item">
                    <ui:VisualElement name="ActivityIcon" class="menu-icon icon-activity" />
                    <ui:Label name="ActivityLabel" class="menu-text"
                        text="Aktivite" />
                </ui:Button>

                <!-- profil -->
                <ui:Button name="ProfileBtn" class="menu-item">
                    <ui:VisualElement name="ProfileIcon" class="menu-icon icon-profile" />
                    <ui:Label name="ProfileLabel" class="menu-text"
                        text="Profil" />
                </ui:Button>

                <!-- simülasyon -->
                <ui:Button name="StartSimulationBtn" class="menu-item">
                    <ui:VisualElement name="StartSimulationIcon" class="menu-icon icon-sim" />
                    <ui:Label name="StartSimulationLabel" class="menu-text"
                        text="Simülasyonu Başlat" />
                </ui:Button>

            </ui:ScrollView>

            <!-- çıkış yap -->
            <ui:VisualElement name="SidebarFooter" class="sidebar-footer">
                <ui:Button name="LogoutBtn" class="menu-item btnLogout">
                    <ui:VisualElement name="LogoutIcon" class="menu-icon icon-logout" />
                    <ui:Label name="LogoutLabel" class="menu-text" text="Çıkış Yap" />
                </ui:Button>

                <ui:Image name="BrandLogo" class="brand-logo-img" />
            </ui:VisualElement>

        </ui:VisualElement>


        <ui:VisualElement name="Main" class="main">
            <ui:VisualElement name="MainContent" class="main-content">

                <ui:VisualElement class="dashboards-top">

                    <ui:VisualElement class="dasboard-user-info">
                        <ui:Label name="TopUsernameLabel" text="-" class="dashboards-top-username" />
                        <ui:Label text="|" class="dashboards-top-divider" />
                        <ui:Label name="TopRoleLabel" text="-" class="dashboards-top-title" />
                    </ui:VisualElement>

                    <ui:VisualElement class="top-navigation">

                        <ui:Button name="SettingsBtn" class="" text="">
                            <ui:VisualElement name="SettingsIcon" class="top-nav-icon icon-settings" />
                        </ui:Button>

                        <ui:Button name="NotificationsBtn" class="" text="">
                            <ui:VisualElement name="NotificationsIcon"
                                class="top-nav-icon icon-bell" />
                        </ui:Button>

                        <ui:Button name="AccountBtn" class="" text="">
                            <ui:VisualElement name="AccountIcon" class="top-nav-icon icon-user" />
                        </ui:Button>

                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- anasayfa -->
                <ui:VisualElement name="HomePage" class="page active">
                    <ui:VisualElement class="welcome-area">

                        <ui:VisualElement class="welcome-text">
                            <ui:Label name="WelcomeUsernameLabel" text="Merhaba, -"
                                class="welcome-username" />
                            <ui:VisualElement class="br" />
                            <ui:Label name="WelcomeMessageLabel" text="-" class="welcome-message" />
                        </ui:VisualElement>

                        <ui:VisualElement class="welcome-hero" />

                    </ui:VisualElement>

                    <ui:VisualElement name="StudentHomePage" class="tc-home">

                        <!-- KPI -->
                        <ui:VisualElement class="tc-kpi-grid">

                            <ui:VisualElement class="tc-kpi-card">
                                <ui:Label text="AG" class="tc-kpi-icon navy" />
                                <ui:VisualElement class="tc-kpi-texts">
                                    <ui:Label name="TcTotalClassValueLabel" text="-"
                                        class="tc-kpi-value" />
                                    <ui:Label text="Toplam Kullanıcı" class="tc-kpi-label" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="tc-kpi-card">
                                <ui:Label text="KS" class="tc-kpi-icon amber" />
                                <ui:VisualElement class="tc-kpi-texts">
                                    <ui:Label name="TcActiveAssignmentValueLabel" text="-"
                                        class="tc-kpi-value" />
                                    <ui:Label text="Aktif Kullanıcı" class="tc-kpi-label" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="tc-kpi-card">
                                <ui:Label text="TD" class="tc-kpi-icon blue" />
                                <ui:VisualElement class="tc-kpi-texts">
                                    <ui:Label name="TcTotalStudentValueLabel" text="-"
                                        class="tc-kpi-value" />
                                    <ui:Label text="Toplam Rol" class="tc-kpi-label" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="tc-kpi-card">
                                <ui:Label text="TD" class="tc-kpi-icon blue" />
                                <ui:VisualElement class="tc-kpi-texts">
                                    <ui:Label name="TcCompletedAssignmentValueLabel" text="-"
                                        class="tc-kpi-value" />
                                    <ui:Label text="Bu Hafta Yeni" class="tc-kpi-label" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                        </ui:VisualElement>

                        <!-- Alt Alan -->
                        <ui:VisualElement class="tc-main-grid">

                            <!-- Sol Panel -->
                            <ui:VisualElement class="tc-panel tc-summary-panel">
                                <ui:VisualElement class="tc-panel-head">
                                    <ui:Label text="Özet" class="tc-panel-title" />
                                    <ui:Label text="Bu Hafta" class="tc-panel-badge" />
                                </ui:VisualElement>

                                <ui:ScrollView name="TcSummaryScroll" class="tc-summary-scroll"
                                    mode="Vertical">

                                    <ui:VisualElement class="tc-summary-item">
                                        <ui:Label text="Son Atanan İş"
                                            class="tc-summary-small" />
                                        <ui:Label name="TcMostActiveClassLabel"
                                            text="-" class="tc-summary-bold" />
                                        <ui:Label text="-"
                                            class="tc-summary-text" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="tc-summary-item">
                                        <ui:Label text="Son Tamamlanan İş"
                                            class="tc-summary-small" />
                                        <ui:Label name="TcTopHomeworkClassLabel"
                                            text="-" class="tc-summary-bold" />
                                        <ui:Label text="-"
                                            class="tc-summary-text" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="tc-summary-item">
                                        <ui:Label text="Deney Sayısı"
                                            class="tc-summary-small" />
                                        <ui:Label name="TcTopHomeworkClassLabel"
                                            text="-" class="tc-summary-bold" />
                                        <ui:Label text="-"
                                            class="tc-summary-text" />
                                    </ui:VisualElement>

                                </ui:ScrollView>
                            </ui:VisualElement>

                            <!-- Sağ Panel -->
                            <ui:VisualElement class="tc-panel tc-chart-panel">
                                <ui:VisualElement class="tc-panel-head">
                                    <ui:Label text="Aktiflik Grafiği" class="tc-panel-title" />
                                    <ui:Label text="Haftalık Görünüm" class="tc-panel-badge" />
                                </ui:VisualElement>

                                <ui:VisualElement class="tc-chart-wrap">
                                    <ui:VisualElement name="StudentActivityChart"
                                        class="tc-chart-box">

                                        <ui:VisualElement
                                            class="tc-chart-grid-line tc-chart-grid-top" />
                                        <ui:VisualElement
                                            class="tc-chart-grid-line tc-chart-grid-mid" />
                                        <ui:VisualElement
                                            class="tc-chart-grid-line tc-chart-grid-low" />

                                        <ui:VisualElement class="tc-chart-bars">
                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarMon"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Pzt" class="tc-chart-x-label" />
                                            </ui:VisualElement>

                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarTue"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Sal" class="tc-chart-x-label" />
                                            </ui:VisualElement>

                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarWed"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Çar" class="tc-chart-x-label" />
                                            </ui:VisualElement>

                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarThu"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Per" class="tc-chart-x-label" />
                                            </ui:VisualElement>

                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarFri"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Cum" class="tc-chart-x-label" />
                                            </ui:VisualElement>

                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarSat"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Cmt" class="tc-chart-x-label" />
                                            </ui:VisualElement>

                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarSun"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Paz" class="tc-chart-x-label" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>

                                    </ui:VisualElement>

                                    <ui:VisualElement class="tc-chart-legend">
                                        <ui:VisualElement class="tc-chart-legend-left">
                                            <ui:VisualElement class="tc-chart-legend-line" />
                                            <ui:Label text="Aktif Saat"
                                                class="tc-chart-legend-text" />
                                        </ui:VisualElement>

                                        <ui:Label name="TcChartPeakInfoLabel" text="Tepe: -"
                                            class="tc-chart-legend-peak" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>

                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- kullanıcı ekle -->
                <ui:VisualElement name="AddUserPage" class="page admin-background">
                    <ui:Label text="Kullanıcı Ekle" class="main-title" />
                    <ui:Label text="Yeni kullanıcı bilgilerini girin." class="main-subtitle" />

                    <ui:VisualElement class="form">
                        <ui:TextField name="AddUser_NameTf" label="Ad" class="AddUser_Textfield" />
                        <ui:TextField name="AddUser_SurnameTf" label="Soyad"
                            class="AddUser_Textfield" />
                        <ui:TextField name="AddUser_EmailTf" label="E-posta"
                            class="AddUser_Textfield" />

                        <ui:TextField name="AddUser_PasswordTf" label="Geçici Şifre"
                            is-password-field="true" class="AddUser_Textfield" />

                        <ui:DropdownField name="AddUser_RoleDd" label="Rol"
                            class="AddUser_Textfield" />

                        <ui:Toggle name="AddUser_IsActiveTg" label="Aktif" value="true" />

                        <ui:VisualElement class="toolbar">
                            <ui:Button name="AddUser_SaveBtn" text="Kaydet" class="primary-btn" />
                            <ui:Button name="AddUser_ClearBtn" text="Temizle" class="primary-btn" />
                        </ui:VisualElement>

                        <ui:Label name="AddUser_StatusLabel" class="status-label" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- kullanıcı listele -->
                <ui:VisualElement name="ListUsersPage" class="page admin-background">
                    <ui:Label text="Kullanıcıları Listele" class="main-title" />

                    <ui:VisualElement class="toolbar">
                        <ui:Button name="RefreshUsersBtn" text="Yenile" />
                        <ui:TextField name="UserSearchTf" placeholder="Ara" />
                    </ui:VisualElement>

                    <ui:ScrollView name="UsersList" class="users-list" />

                    <ui:Label name="UsersStatusLabel" class="status-label" />
                </ui:VisualElement>

                <!-- rol -->
                <ui:VisualElement name="RolesPage" class="page admin-background">
                    <ui:Label text="Roller" class="main-title" />
                    <ui:Label text="Rolleri görüntüle, rol ekle ve kullanıcıya rol ata."
                        class="main-subtitle" />


                    <ui:VisualElement class="toolbar">
                        <ui:Button name="Roles_RefreshBtn" text="Yenile" class="primary-btn" />
                        <ui:Label name="Roles_StatusLabel" class="status-label" text="" />
                    </ui:VisualElement>

                    <ui:VisualElement class="two-col">
                        <ui:VisualElement class="panel">
                            <ui:Label text="Rol Listesi" class="panel-title" />
                            <ui:ScrollView name="Roles_List" class="list" />
                        </ui:VisualElement>

                        <ui:VisualElement class="panel">
                            <ui:Label text="Rol Ekle" class="panel-title" />

                            <ui:TextField name="Roles_NewNameTf" label="Rol Adı"
                                class="AddUser_Textfield" />
                            <ui:TextField name="Roles_NewDescTf" label="Açıklama"
                                class="AddUser_Textfield" />

                            <ui:VisualElement class="toolbar">
                                <ui:Button name="Roles_AddBtn" text="Rol Ekle" class="primary-btn" />
                            </ui:VisualElement>

                            <ui:VisualElement class="hr" />

                            <ui:Label text="Kullanıcıya Rol Ata" class="panel-title" />

                            <ui:DropdownField name="Roles_UserDd" label="Kullanıcı"
                                class="AddUser_Textfield" />
                            <ui:DropdownField name="Roles_RoleDd" label="Rol"
                                class="AddUser_Textfield" />

                            <ui:VisualElement class="toolbar">
                                <ui:Button name="Roles_AssignBtn" text="Rol Ata" class="primary-btn" />
                            </ui:VisualElement>

                            <ui:Label name="Roles_ActionLabel" class="status-label" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- izin -->
                <ui:VisualElement name="PermissionsPage" class="page admin-background">
                    <ui:Label text="İzinler" class="main-title" />
                    <ui:Label text="İzin yönetimi burada olacak..." class="main-subtitle" />
                </ui:VisualElement>

                <!-- öğretmen başvuruları -->
                <ui:VisualElement name="TeacherRequestsPage" class="page admin-background">
                    <ui:Label text="Öğretmen Olma İstekleri" class="main-title" />
                    <ui:Label text="Bağımsız kullanıcıların öğretmen rolü başvurularını onaylayın veya reddedin."
                        class="main-subtitle" />

                    <ui:VisualElement class="toolbar">
                        <ui:Button name="TeacherRequestsRefreshBtn" text="Yenile" class="primary-btn" />
                        <ui:Label name="TeacherRequestsStatusLabel" class="status-label" text="" />
                    </ui:VisualElement>

                    <ui:ScrollView name="TeacherRequestsList" class="users-list" />
                </ui:VisualElement>

                <!-- görev ata -->
                <ui:VisualElement name="CreatorsPage" class="page task-page">

                    <!-- stats -->
                    <ui:VisualElement class="task-stats-grid">

                        <ui:VisualElement class="task-stat-card">
                            <ui:Label text="AG" class="task-stat-icon" />
                            <ui:VisualElement class="task-stat-texts">
                                <ui:Label text="128" name="TaskActiveCountLabel"
                                    class="task-stat-value" />
                                <ui:Label text="Aktif Görevler" class="task-stat-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="task-stat-card">
                            <ui:Label text="BT" class="task-stat-icon warning" />
                            <ui:VisualElement class="task-stat-texts">
                                <ui:Label text="17" name="TaskTodayDeadlineCountLabel"
                                    class="task-stat-value" />
                                <ui:Label text="Bugün Teslim Edilecekler" class="task-stat-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="task-stat-card">
                            <ui:Label text="GC" class="task-stat-icon danger" />
                            <ui:VisualElement class="task-stat-texts">
                                <ui:Label text="9" name="TaskOverdueCountLabel"
                                    class="task-stat-value" />
                                <ui:Label text="Geciken Görevler" class="task-stat-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="task-stat-card">
                            <ui:Label text="İN" class="task-stat-icon info" />
                            <ui:VisualElement class="task-stat-texts">
                                <ui:Label text="24" name="TaskReviewCountLabel"
                                    class="task-stat-value" />
                                <ui:Label text="İncelemedeki Görevler" class="task-stat-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- content -->
                    <ui:VisualElement class="task-content-grid">

                        <!-- sol -->
                        <ui:VisualElement class="task-main-card">

                            <ui:VisualElement class="task-main-header">
                                <ui:Label text="Görev Oluştur ve Ata" class="task-main-title" />
                                <ui:Label
                                    text="İçerik üretim akışını hızlandırmak için görevi ayrıntılı şekilde tanımlayın."
                                    class="task-main-subtitle" />
                            </ui:VisualElement>

                            <ui:VisualElement class="task-form-shell">

                                <ui:ScrollView name="TaskFormScroll" class="task-form-scroll"
                                    mode="Vertical">

                                    <ui:VisualElement class="task-two-col-grid">

                                        <ui:VisualElement class="task-field-group">
                                            <ui:Label text="Görev Başlığı" class="task-field-label" />
                                            <ui:TextField name="TaskTitleInput" class="task-input" />
                                        </ui:VisualElement>

                                        <ui:VisualElement class="task-field-group">
                                            <ui:Label text="Başlangıç Tarihi"
                                                class="task-field-label" />
                                            <ui:TextField name="TaskStartDateInput"
                                                class="task-input" />
                                        </ui:VisualElement>

                                        <ui:VisualElement class="task-field-group">
                                            <ui:Label text="Görev Türü" class="task-field-label" />
                                            <ui:DropdownField name="TaskTypeDropdown"
                                                class="task-input" />
                                        </ui:VisualElement>

                                        <ui:VisualElement class="task-field-group">
                                            <ui:Label text="Son Teslim Tarihi"
                                                class="task-field-label" />
                                            <ui:TextField name="TaskDeadlineInput"
                                                class="task-input" />
                                        </ui:VisualElement>

                                        <ui:VisualElement class="task-field-group">
                                            <ui:Label text="İlgili Deney" class="task-field-label" />
                                            <ui:TextField name="TaskExperimentInput"
                                                class="task-input" />
                                        </ui:VisualElement>

                                        <ui:VisualElement class="task-field-group">
                                            <ui:Label text="Tahmini Süre" class="task-field-label" />
                                            <ui:TextField name="TaskEstimatedDurationInput"
                                                class="task-input" />
                                        </ui:VisualElement>

                                        <ui:VisualElement class="task-field-group">
                                            <ui:Label text="Atanacak İçerik Üreticisi"
                                                class="task-field-label" />
                                            <ui:DropdownField name="TaskAssigneeDropdown"
                                                class="task-input" />
                                        </ui:VisualElement>

                                        <ui:VisualElement class="task-field-group">
                                            <ui:Label text="Öncelik" class="task-field-label" />
                                            <ui:DropdownField name="TaskPriorityDropdown"
                                                class="task-input" />
                                        </ui:VisualElement>

                                    </ui:VisualElement>

                                    <ui:VisualElement class="task-full-width-group">
                                        <ui:Label text="Görev Açıklaması" class="task-field-label" />
                                        <ui:TextField name="TaskDescriptionInput" multiline="true"
                                            class="task-textarea" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="task-full-width-group">
                                        <ui:Label text="Beklenen Çıktı / Teslim İçeriği"
                                            class="task-field-label" />
                                        <ui:TextField name="TaskExpectedOutputInput"
                                            multiline="true" class="task-textarea" />
                                    </ui:VisualElement>

                                </ui:ScrollView>

                                <ui:VisualElement class="task-action-row">
                                    <ui:Button name="AssignTaskBtn" text="Görevi Ata"
                                        class="btn-task-primary" />
                                </ui:VisualElement>
                                <ui:Label name="AssignTaskStatusLabel" class="status-label" text="" />

                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- sağ -->
                        <ui:VisualElement class="task-preview-card">

                            <ui:VisualElement class="preview-header">
                                <ui:Label text="Görev Önizleme" class="preview-title" />
                                <ui:Label text="Canlı Taslak" class="preview-chip" />
                            </ui:VisualElement>

                            <ui:VisualElement class="preview-body">
                                <ui:Label text="Fotosentez Simülasyonu Sahne Güncellemesi"
                                    name="PreviewTaskTitleLabel" class="preview-task-title" />
                                <ui:Label text="Atanan Kişi: Elif Kaya"
                                    name="PreviewTaskAssigneeLabel" class="preview-task-person" />

                                <ui:VisualElement class="preview-badges">
                                    <ui:Label text="İncelemede" name="PreviewStatusBadge"
                                        class="badge-status" />
                                    <ui:Label text="Yüksek Öncelik" name="PreviewPriorityBadge"
                                        class="badge-priority" />
                                </ui:VisualElement>

