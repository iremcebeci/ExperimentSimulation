:root {
    --base-clr: #f1f4f9;
    --line-clr: #c2c2c2;
    --boxes-bg-clr: #ffffff;
    --hover-clr: #243567;
    --text-clr: #1E1E1E;
    --accent-clr: #243567;
    --secondary-text-clr: #F5F5F5;
    --logout-clr: #d32f2f;
    -unity-font-definition: resource("Fonts/Montserrat-Regular");
    font-size: 20px;
}

.root{
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: var(--base-clr);
    color: var(--text-clr);
}

#Root {
    flex-direction: row;
    width: 100%;
    height: 100%;
}

/* Genel input davranışı */
.unity-base-field {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
}

/* İç yazı alanı */
.unity-base-field__input {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
}

/* Asıl text input */
.unity-text-input {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
    overflow: hidden;
}

/* Scrollbar style (UI Toolkit - version safe) */
.unity-scroll-view__vertical-scroller {
    width: 10px;
    min-width: 10px;
    background-color: transparent;
}

.unity-scroll-view__horizontal-scroller {
    height: 10px;
    min-height: 10px;
    background-color: transparent;
}

.unity-scroll-view__vertical-scroller,
.unity-scroll-view__horizontal-scroller,
.unity-scroller,
.unity-scroller__track,
.unity-base-slider__track {
    background-color: transparent;
    border-width: 0;
    border-radius: 5px;
    padding: 0;
}

.unity-scroller__slider,
.unity-base-slider__dragger {
    background-color: #243567;
    border-width: 0;
    border-radius: 5px;
    margin-left: -1px;
}

.unity-scroller--vertical .unity-scroller__slider,
.unity-scroller--vertical .unity-base-slider__dragger,
.unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    width: 10px;
    min-height: 28px;
}

.unity-scroller--horizontal .unity-scroller__slider,
.unity-scroller--horizontal .unity-base-slider__dragger,
.unity-scroll-view__horizontal-scroller .unity-base-slider__dragger {
    height: 10px;
    min-width: 28px;
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
    border-width: 0;
    background-color: transparent;
}


/* main  */
.main{
    flex-grow: 1;
    height: 100%;
    padding: 20px;
    box-sizing: border-box;
}

.main-content{
    padding: 20px;
    border-radius: 8px;
    box-sizing: border-box;
}

.main-title{
    font-size: 24px;
    font-weight: bold;
    color: var(--text-clr);
    margin-bottom: 8px;
}

.main-subtitle{
    font-size: 14px;
    color: var(--text-clr);
    opacity: 0.7;
}

/* sidebar */
.sidebar{
    box-sizing: border-box;
    flex-direction: column;
    width: 330px;
    height: 100%;
    padding-top: 12px;
    padding-bottom: 0px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: var(--boxes-bg-clr);
    border-right-width: 1px;
    border-right-style: solid;
    border-right-color: var(--line-clr);
    overflow: hidden;
    white-space: nowrap;
}

.sidebar.close{
    width: 80px;
    padding-left: 5px;
    padding-right: 5px;
}

.sidebar.close .logo{
    display: none;
}

.sidebar.close .menu-text{
    display: none;
}

.sidebar.close .menu-chevron{
    display: none;
}

.sidebar{
    transition-property: width, padding-left, padding-right;
    transition-duration: 0.3s;
    transition-timing-function: ease;
}

.menu{
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-basis: auto;
}

.menu > .unity-scroll-view__content-viewport{
    flex-grow: 1;
}

.menu > .unity-scroll-view__content-container{
    align-items: stretch;
    padding-right: 0px;
    min-height: auto;
}

.sidebar-footer{
    flex-direction: column;
    flex-shrink: 0;
    padding-top: 8px;
    padding-bottom: 12px;
}

.sidebar-header-item{
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    gap: 6px;
}

.logo{
    font-weight: 600;
    font-size: 20px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 6px;
    color: var(--text-clr);
    white-space: nowrap;
    overflow: visible;
}

.toggle-btn{
    margin-left: auto;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 6px;
    background-color: transparent;
    border-width: 0px;
}

.toggle-btn.rotate{
    transform-origin: center;
    rotate: 180deg;
}

#ToggleIcon{
    transition-property: rotate;
    transition-duration: 0.3s;
    transition-timing-function: ease;
}

.menu-item{
    width: auto;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 6px;
    background-color: transparent;
    border-width: 0px;
    align-self: stretch;
    box-sizing: border-box;
    min-width: 0px;
}

.sidebar.close .menu-item{
    width: auto;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
}

.dropdown-btn{
    text-align: left;
}

.menu-text{
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    color: var(--text-clr);
    text-align: left;
    font-size: 20px;
    -unity-text-align: middle-left;
}

.menu-icon{
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-clr);
}

.menu-chevron{
    width: 30px;
    height: 30px;
    margin-left: auto;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-clr);
    transition-property: rotate;
    transition-duration: 0.3s;
    transition-timing-function: ease;
}

.menu-item:hover,
.dropdown-btn:hover{
    background-color: var(--hover-clr);
}

.menu-item:hover .menu-text,
.dropdown-btn:hover .menu-text{
    color: var(--secondary-text-clr);
}

.menu-item:hover .menu-icon,
.dropdown-btn:hover .menu-icon,
.menu-item:hover .menu-chevron,
.dropdown-btn:hover .menu-chevron{
    -unity-background-image-tint-color: var(--secondary-text-clr);
}

.menu-item.active{
    background-color: var(--accent-clr);
}

.menu-item.active .menu-text{
    color: var(--secondary-text-clr);
}

.menu-item.active .menu-icon,
.menu-item.active .menu-chevron{
    -unity-background-image-tint-color: var(--secondary-text-clr);
}

.sub-menu{
    display: none;
    flex-direction: column;
    padding-left: 26px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.sub-menu.show{
    display: flex;
}

.sub-menu-item{
    width: 90%;
    text-align: left;
    font-size: 20px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 6px;
    background-color: transparent;
    border-width: 0px;
    color: var(--text-clr);
    -unity-text-align: middle-left;
}

.sub-menu-item:hover{
    background-color: var(--hover-clr);
    color: var(--secondary-text-clr);
}

.sub-menu-item.active{
    background-color: var(--accent-clr);
    color: var(--secondary-text-clr);
}

.menu-chevron.rotate{
    rotate: 180deg;
}

.btnLogout{
    margin-top: 0px;
    margin-bottom: 8px;
}

.btnLogout .menu-icon{
    -unity-background-image-tint-color: var(--logout-clr);
}

.btnLogout:hover{
    background-color: var(--logout-clr);
}

.btnLogout:hover .menu-text{
    color: var(--secondary-text-clr);
}

.btnLogout:hover .menu-icon{
    -unity-background-image-tint-color: var(--secondary-text-clr);
}

.btnLogout.active{
    background-color: var(--logout-clr);
}

.btnLogout.active .menu-text{
    color: var(--secondary-text-clr);
}

.btnLogout.active .menu-icon{
    -unity-background-image-tint-color: var(--secondary-text-clr);
}

.brand-logo-img{
    width: 40px;
    height: 40px;
    margin-top: 0px;
    margin-bottom: 8px;
    align-self: center;
    background-image: resource("Icons/logo_light");
    -unity-background-scale-mode: scale-to-fit;
}

/* çıkış popup */
.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    justify-content: center;
    align-items: center;
}

.modal-card {
    width: 440px;
    max-width: 90%;
    padding: 16px;
    background-color: #ffffff;
    border-radius: 14px;
    -unity-box-shadow: 0px 12px 30px rgba(0,0,0,0.35);
}

.modal-title {
    font-size: 18px;
    unity-font-style: bold;
    margin-bottom: 6px;
}

.modal-desc {
    opacity: 0.8;
    margin-bottom: 14px;
}

.modal-actions {
    flex-direction: row;
    justify-content: flex-end;
    gap: 8px;
}

.btn-primary {
    background-color: #243567;
    color: white;
    border-radius: 10px;
    padding-left: 12px;
    padding-right: 12px;
    height: 34px;
}

.btn-secondary {
    background-color: rgba(36, 53, 103, 0.10);
    color: #243567;
    border-radius: 10px;
    padding-left: 12px;
    padding-right: 12px;
    height: 34px;
}

.btn-danger {
    background-color: #d9534f;
    color: white;
    border-radius: 10px;
    padding-left: 12px;
    padding-right: 12px;
    height: 34px;
}

.page {
    display: none;
    flex-grow: 1;
}

.page.active {
    display: flex;
    flex-direction: column;
}

.admin-background {
    background-color: #ffffff;
    border-radius: 16px;
    padding: 16px;
    margin-top: 8px;
    -unity-box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.08);
}

.toolbar {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    margin-bottom: 14px;
}

#UserSearchTf {
    flex-grow: 1;
    min-width: 300px;
    border-radius: 10px;
}

#RefreshUsersBtn {
    height: 34px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 10px;
}

.users-list, #UsersList {
    flex-grow: 1;
    margin-top: 6px;
}

.users-list > .unity-scroll-view__content-viewport,
#UsersList > .unity-scroll-view__content-viewport {
    padding-right: 8px;
}

.user-row {
    flex-direction: column;
    gap: 6px;
    padding: 12px 14px;
    margin-bottom: 10px;
    border-radius: 14px;
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    unity-background-image-tint-color: rgba(0,0,0,0);
}

.user-row:hover {
    border-left-width: 4px;
}

.user-title {
    font-size: 16px;
    unity-font-style: bold;
    margin-bottom: 1px;
}

.user-sub {
    opacity: 0.85;
    font-size: 12px;
}

.user-row-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 4px;
}

.user-delete-btn {
    height: 30px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 8px;
    background-color: #c62828;
    color: #ffffff;
    border-width: 0;
}

.user-delete-btn:hover {
    background-color: #a61f1f;
}

.status-label, #UsersStatusLabel {
    margin-top: 10px;
    opacity: 0.85;
    font-size: 12px;
}

.form {
    margin-top: 12px;
    gap: 10px;
}

.form > * {
    margin-bottom: 6px;
}

.primary-btn {
    height: 36px;
    border-radius: 10px;
    padding-left: 14px;
    padding-right: 14px;
}

#AddUser_StatusLabel {
    margin-top: 8px;
    opacity: 0.9;
}

.AddUser_Textfield {
    flex-direction: row;
    align-items: center;
}

.AddUser_Textfield > .unity-base-field__label {
    width: 120px;
    unity-text-align: middle-left;
}

.AddUser_Textfield > .unity-base-field__input {
    flex-grow: 1;
    margin-left: 0px;
}

.AddUser_Textfield > .unity-base-field__input {
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    overflow: hidden;
}

.AddUser_Textfield .unity-popup-field__input {
    border-radius: 10px;
    overflow: hidden;
}

.form-row Textfield .unity-text-input {
    background-color: transparent;
    border-width: 0;
    color: var(--text-clr);
    font-size: 20px;
}

/* Bazı Unity sürümlerinde wrapper da boyuyor */
.form-row TextField .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
}

.two-col {
    flex-direction: row;
    gap: 14px;
    margin-top: 10px;
    flex-grow: 1;
}

.panel {
    flex-grow: 1;
    padding: 14px;
    border-radius: 14px;
}

.panel-title {
    unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 8px;
}

.list {
    flex-grow: 1;
    margin-top: 6px;
}

.hr {
    height: 1px;
    margin-top: 14px;
    margin-bottom: 14px;
    opacity: 0.2;
}

.role-row {
    padding: 10px 12px;
    margin-bottom: 10px;
    border-radius: 12px;
}

.role-name {
    unity-font-style: bold;
    font-size: 14px;
}

.role-desc {
    opacity: 0.85;
    font-size: 12px;
    margin-top: 2px;
}

/* main layout */
.teacher-main-content{
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    gap: 20px;
    flex-grow: 1;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
}

/* dashboards top */
.dashboards-top {
    height: 80px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
    margin-bottom: 50px;
}

.dasboard-user-info {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    color: var(--text-clr);
}

/* top navigation */
.top-navigation {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.top-navigation Button {
    border-width: 0px;
    background-color: var(--boxes-bg-clr);
    border-radius: 10px;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.top-nav-icon{
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-clr);
}

/* Ana Konteynır */
.welcome-area {
    height: 250px;
    display: flex;
    flex-direction: row;
    /* Yan yana dizilim */
    align-items: center;
    background-color: white;
    border-radius: 18px;
    padding-left:20px;
    overflow: visible;
    /* Taşma için bu kalmalı */
    -unity-box-shadow: 0px 10px 24px rgba(0,0,0,0.12);
}

.dashboards-top-username{
    font-size: 30px;
    font-weight: 600;
    -unity-font-definition: resource("Fonts/Montserrat-Bold");
}

.dashboards-top-divider{
    font-size: 30px;
    border-radius: 50%;
}

.dashboards-top-title{
    font-size: 20px;
}

.welcome-text {
    flex-grow: 1;
    /* Metin kutusu alabildiği kadar alanı alır */
    flex-shrink: 1;
    /* Alan daralırsa metin küçülür */
    min-width: 0;
    /* Flex içinde metnin hero'nun altına/arkasına taşmasını engeller */
    padding-right: 20px;
}

.welcome-text Label {
    white-space: normal;
}

.welcome-username{
    font-size: 30px;
    font-weight: 600;
    -unity-font-definition: resource("Fonts/Montserrat-Bold");
}

.welcome-message{
    font-size: 20px;
}

.welcome-hero {
    /* Absolute'u sildik! */
    width: 405px;
    height: 270px;
    /* Taşma efekti için sadece margin-bottom kullanıyoruz */
    margin-bottom: 0;
    align-self: flex-end;
    /* Alt kenara yasla */
    background-image: url("project://database/Assets/Images/welcome-image.png");
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
    background-position: right bottom;
    background-size: initial;
    -unity-background-image-tint-color: rgba(255,255,255,1);
    opacity: 1;
}

/* <br> placeholder */
.br {
    height: 10px;
}

/* teacher stats */
.t-class-statistics{
    display: flex;
    flex-direction: row;
    margin-right: -20px;
    /* sondaki boşluğu geri alır */
}

/* Cards */
.t-class-statistics-item{
    flex: 1;
    /* flex-grow:1 yerine */
    min-width: 0;
    /* label taşmalarında önemli */
    margin-right: 20px;
    background-color: var(--boxes-bg-clr);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.t-class-statistics-top {
    background-color: var(--accent-clr);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    height: 40px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--secondary-text-clr);
}

.t-class-statistics-bottom {
    width: 100%;
    height: 90px;
    padding: 20px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    box-sizing: border-box;
}

.t-class-statistics-bottom .result {
    height: 100%;
    width: 35%;
    font-size: 30px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
}

.legacy-statistics {
    height: 100%;
    width: 65%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
}

.legacy-statistics Label {
    font-size: 15px;
    color: var(--text-p);
}

.legacy-statistics .total-result {
    font-size: 17px;
    color: var(--text-p);
}

/* classes container */
.classes-container {
    margin-left: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 20px;
    flex: 1 1 auto;
    min-height: 0;
}

.classes-top {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

/* search box */
.icon{
    width: 20px;
    height: 20px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

.search-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 10px;
    background-color: var(--boxes-bg-clr);
    width: 25%;
    height: 50px;
    border-radius: 10px;
    margin-top: 20px;
    margin-bottom: 20px;
}

.search-box TextField {
    border-width: 0px;
    width: 90%;
    font-size: 20px;
    border-width: 0;
    background-color: transparent;
    -unity-text-align: middle-left;
}

/* Asıl gri gelen input kısmı */
.search-box TextField .unity-text-input {
    background-color: transparent;
    border-width: 0;
    color: var(--text-clr);
    font-size: 20px;
}

/* Bazı Unity sürümlerinde wrapper da boyuyor */
.search-box TextField .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
}

.add-class-btn {
    padding-top: 10px;
    padding-right: 20px;
    padding-bottom: 10px;
    padding-left: 20px;
    right: 15px;
    background-color: var(--accent-clr);
    color: var(--secondary-text-clr);
    border-width: 0px;
    border-radius: 10px;
}

.add-class-btn:hover {
    background-color: var(--hover-clr);
}

.join-class-btn {
    padding-top: 10px;
    padding-right: 20px;
    padding-bottom: 10px;
    padding-left: 20px;
    right: 15px;
    background-color: var(--accent-clr);
    color: var(--secondary-text-clr);
    border-width: 0px;
    border-radius: 10px;
}

.join-class-btn:hover {
    background-color: var(--hover-clr);
}

/* filter row */
.filter-check {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

/* classes bottom (scroll area) */
.classes-bottom {
    flex: 1 1 auto;
    /* büyüsün + gerekirse küçülsün */
    min-height: 0;
    /* ÇOK ÖNEMLİ: yoksa scroll çalışmaz */
    overflow-y: auto;
    padding-bottom: 20px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: var(--boxes-bg-clr);
}

/* header row */
.classes-header-row {
    display: flex;
    flex-direction: row;
    padding: 10px;
    background-color: var(--accent-clr);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    color: var(--secondary-text-clr);
}

.classes-header-row .col {
    width: 12.5%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.classes-top,
.filter-check,
.classes-header-row{
    flex-shrink: 0;
}

/* class row */
.class-row {
    width: 100%;
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    padding: 10px;
    box-sizing: border-box;
    background-color: var(--boxes-bg-clr);
    border-bottom-width: 1px;
    border-bottom-style: solid;
    border-bottom-color: var(--line-clr);
}

.class-row .col {
    width: 12.5%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.class-code {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
}

.copy-btn {
    border-width: 0px;
    background-color: transparent;
    opacity: 0.6;
}

.copy-btn:hover {
    opacity: 1;
    scale: 1.1;
}

.go-class-btn {
    padding-top: 5px;
    padding-right: 10px;
    padding-bottom: 5px;
    padding-left: 10px;
    background-color: var(--accent-clr);
    color: var(--secondary-text-clr);
    border-width: 0px;
    border-radius: 5px;
}

.go-class-btn:hover {
    background-color: var(--hover-clr);
}

/* badges */
.badge {
    padding-top: 3px;
    padding-right: 8px;
    padding-bottom: 3px;
    padding-left: 8px;
    border-radius: 999px;
}

.badge.active {
    background-color: rgba(36, 53, 103, 0.12);
    color: var(--text-clr);
}

/* modal */
.modal-backdrop {
    position: absolute;
    /* TODO: UI Toolkit overlay positioning; often done with full-screen VisualElement */
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0,0,0,0.35);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modal-backdrop.open {
    display: flex;
}

.modal {
    width: 520px;
    background-color: var(--boxes-bg-clr);
    border-radius: 12px;
    overflow: hidden;
}

.modal-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    background-color: var(--accent-clr);
    color: var(--secondary-text-clr);
}

.modal-close {
    border-width: 0px;
    background-color: transparent;
    color: var(--secondary-text-clr);
    font-size: 26px;
    opacity: 0.9;
}

.modal-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.form-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.form-row Label {
    font-size: 13px;
    color: var(--text-clr);
    opacity: 0.85;
}

.form-row TextField {
    height: 44px;
    border-radius: 10px;
    border-width: 1px;
    border-style: solid;
    border-color: rgba(0,0,0,0.12);
    background-color: white;
    padding-left: 12px;
    padding-right: 12px;
}

.modal-footer {
    padding: 14px 16px;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    gap: 10px;
    background-color: rgba(0,0,0,0.02);
}

.btn-primary, .btn-secondary {
    border-width: 0px;
    border-radius: 10px;
    height: 40px;
    padding-left: 14px;
    padding-right: 14px;
}

.btn-primary {
    background-color: var(--accent-clr);
    color: var(--secondary-text-clr);
}

.btn-primary:hover {
    background-color: var(--hover-clr);
}

.btn-secondary {
    background-color: rgba(0,0,0,0.06);
    color: var(--text-clr);
}

/* --- Simulation Page --- */
.simulation-page {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    background-image: url("project://database/Assets/Images/2.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

/* Background image (cover) */
.sim-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* Image element cover */
    -unity-background-scale-mode: scale-and-crop;
    opacity: 1;
}

/* container: sağa hizala */
.sim-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-right: 100px;
    box-sizing: border-box;
}

/* box: 600x700 */
.sim-box {
    width: 600px;
    height: 700px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
}

/* logo */
.sim-logo {
    width: 200px;
    height: 200px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Images/logo_light.png");
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

/* title */
.sim-title {
    font-size: 60px;
    color: var(--secondary-text-clr);
    unity-text-shadow: 0 4px 12px rgba(0,0,0,0.4);
}

/* button */
.sim-btn {
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 12px;
    padding-bottom: 12px;
    font-size: 20px;
    color: var(--text-clr);
    background-color: var(--boxes-bg-clr);
    border-radius: 8px;
    margin-top: 150px;
}

.sim-btn:hover {
    background-color: var(--accent-clr);
    color: var(--secondary-text-clr);
}

/* Sadece simülasyon sayfasında üst bar gizle */
.hide-topbar .dashboards-top {
    display: none;
}

/* -------------------- ADD ASSIGNMENT PAGE -------------------- */
.add-assignment-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-left: 6px;
    padding-right: 6px;
}

.information-text {
    color: #6e768a;
    font-size: 13px;
}

.day-buttons {
    flex-direction: row;
    align-items: center;
}

.assignment-nav-btn {
    width: 32px;
    height: 32px;
    min-width: 32px;
    margin-left: 8px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    background-color: #243567;
    color: white;
    -unity-font-style: bold;
}

.timeline-assignment {
    flex-grow: 1;
    min-height: 520px;
    background-color: #ffffff;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #d8deea;
    border-right-color: #d8deea;
    border-bottom-color: #d8deea;
    border-left-color: #d8deea;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    overflow: hidden;
}

.timeline-days {
    flex-direction: row;
    height: 62px;
    background-color: #243567;
}

.timeline-day {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    border-right-width: 1px;
    border-right-color: #4f6093;
}

.timeline-day-date {
    color: white;
    font-size: 11px;
    -unity-font-style: bold;
}

.timeline-day-name {
    color: white;
    font-size: 12px;
}

.timeline-contents {
    flex-grow: 1;
    flex-direction: column;
}

.timeline-row {
    flex-grow: 1;
    min-height: 56px;
    flex-direction: row;
    border-top-width: 1px;
    border-top-color: #d8deea;
    position: relative;
}

.timeline-col {
    flex-grow: 1;
    border-right-width: 1px;
    border-right-color: #d8deea;
    align-items: center;
    justify-content: center;
}

.timeline-col-selected {
    background-color: rgba(36, 53, 103, 0.10);
}

.assignment-block {
    position: absolute;
    height: 100px;
    background-color: #243567;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    justify-content: center;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.assignment-block-title {
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
}

.assignment-block-class {
    color: rgba(255, 255, 255, 0.85);
    font-size: 10px;
}

.assignment-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.35);
    justify-content: center;
    align-items: center;
}

.hidden {
    display: none;
}

.assignment-modal-card {
    width: 460px;
    background-color: white;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.assignment-modal-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.assignment-modal-title {
    font-size: 18px;
    color: #243567;
    -unity-font-style: bold;
}

.close-assignment-modal-btn {
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    background-color: #eef1f7;
    color: #243567;
}

.assignment-form {
    flex-direction: column;
}

.form-group {
    flex-direction: column;
    margin-bottom: 12px;
}

.form-group-label {
    margin-bottom: 6px;
    font-size: 13px;
    color: #243567;
    -unity-font-style: bold;
}

.assignment-input {
    min-height: 40px;
}

.assignment-textarea {
    min-height: 90px;
}

.form-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

/* =========================
   CLASS DETAILS PAGE
   ========================= */

.class-details-card {
    background-color: var(--boxes-bg-clr);
    border-radius: 10px;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    margin: 0 20px;
    min-height: 116px;
    flex-shrink: 0;
}

.class-details-column {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.class-details-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 42px;
    padding: 0 10px;
    border-top-width: 1px;
    border-top-color: #cfd6e6;
}

.class-details-column > .class-details-row:last-child {
    border-bottom-width: 1px;
    border-bottom-color: #cfd6e6;
}

.class-details-title {
    width: 50%;
    font-size: 13px;
    color: #6e7482;
    -unity-text-align: middle-left;
}

.class-details-value {
    width: 50%;
    font-size: 13px;
    color: #5d6370;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
}

.inline-value-label {
    font-size: 13px;
    color: #5d6370;
    -unity-font-style: bold;
}

.with-icon {
    width: 50%;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
}

.cd-box {
    min-width: 220px;
    max-width: 240px;
    background-color: #2f447b;
    border-radius: 10px;
    padding: 10px 12px;
    justify-content: center;
    align-items: stretch;
}

.cd-box .class-details-row {
    border-top-width: 0;
    border-bottom-width: 0;
    justify-content: center;
    padding: 0;
}

.cd-title-row {
    min-height: 28px;
}

.cd-box-row {
    min-height: 54px;
}

.cd-title {
    font-size: 12px;
    color: rgba(255,255,255,0.75);
    -unity-text-align: middle-center;
}

.cd-box-main-label {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.icon-only-btn {
    width: 22px;
    height: 22px;
    min-width: 22px;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
}

.small-inline-icon {
    width: 14px;
    height: 14px;
    border-radius: 3px;
}

.class-action-btn {
    height: 30px;
    min-width: 110px;
    padding: 0 12px;
    background-color: #2f447b;
    color: white;
    border-width: 0;
    border-radius: 10px;
    font-size: 12px;
    -unity-font-style: bold;
}

.stats-row {
    flex-direction: row;
    gap: 8px;
    margin: 16px 20px 0 20px;
    flex-shrink: 0;
    align-items: flex-end;
}

.stat-card {
    height: 42px;
    min-width: 150px;
    padding: 0 18px;
    background-color: #4b5f97;
    color: white;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-width: 0;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    -unity-font-style: bold;
}

.stat-card.active {
    background-color: var(--boxes-bg-clr);
    color: #2f447b;
}

.table-card {
    flex-grow: 1;
    margin: -1px 20px 20px 20px;
    background-color: var(--boxes-bg-clr);
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}

.cg-general-shell {
    padding: 18px 16px 16px 16px;
    height: 900px;
}

.cg-analytics {
    flex-grow: 1;
    flex-direction: row;
    gap: 16px;
    min-height: 0;
}

.cg-card {
    flex-grow: 1;
    background-color: #ffffff;
    border-radius: 12px;
    border-width: 1px;
    border-color: #e5eaf5;
    flex-direction: column;
    overflow: hidden;
}

.cg-card-head {
    min-height: 50px;
    padding: 0 16px;
    border-bottom-width: 1px;
    border-bottom-color: #edf1f8;
    justify-content: center;
}

.cg-card-head Label {
    font-size: 15px;
    color: #1f1f1f;
    -unity-font-style: bold;
}

.cg-card-body {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 24px;
    gap: 10px;
}

.cg-card-body-chart {
    padding: 14px;
}

.cg-donut-wrap {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.cg-donut {
    width: 150px;
    height: 150px;
    border-radius: 75px;
    border-top-width: 16px;
    border-right-width: 16px;
    border-bottom-width: 16px;
    border-left-width: 16px;
    border-top-color: #3f73ea;
    border-right-color: #3f73ea;
    border-bottom-color: #3f73ea;
    border-left-color: #dfe7f7;
    align-items: center;
    justify-content: center;
    position: relative;
}

.cg-donut-hole {
    position: absolute;
    width: 102px;
    height: 102px;
    background-color: white;
    border-radius: 51px;
}

.cg-donut-center {
    align-items: center;
    justify-content: center;
}

.cg-donut-percent {
    font-size: 22px;
    color: #2f447b;
    -unity-font-style: bold;
}

.cg-donut-subtitle {
    margin-top: 4px;
    font-size: 11px;
    color: #a0a7b5;
}

.cg-progress-info {
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 4px;
}

.cg-progress-info .ok {
    font-size: 13px;
    color: #67a273;
    -unity-font-style: bold;
}

.cg-progress-info .warn {
    font-size: 13px;
    color: #d39753;
    -unity-font-style: bold;
}

.cg-bar-chart-wrap {
    flex-grow: 1;
    width: 100%;
    min-height: 280px;
    border-width: 1px;
    border-color: #e2e8f5;
    border-radius: 10px;
    background-color: #f7f9fe;
    padding: 14px 16px 12px 16px;
    position: relative;
    justify-content: flex-end;
}

.cg-chart-grid {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 14px;
    bottom: 34px;
    justify-content: space-between;
}

.cg-grid-line {
    height: 1px;
    background-color: #dfe5f2;
}

.cg-bars-area {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
    min-height: 0;
}

.cg-bar-item {
    flex-grow: 1;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.cg-bar-value {
    margin-bottom: 6px;
    font-size: 11px;
    color: #6e7da0;
    -unity-font-style: bold;
}

.cg-bar-track {
    width: 22px;
    height: 180px;
    justify-content: flex-end;
    background-color: #e8eef9;
    border-radius: 999px;
    overflow: hidden;
}

.cg-bar-fill {
    width: 100%;
    border-radius: 999px;
    background-color: #3f73ea;
}

.cg-bar-label {
    margin-top: 8px;
    font-size: 11px;
    color: #7b88a6;
    -unity-font-style: bold;
}

/* örnek yükseklikler */
.cg-bar-fill.h1 { height: 72px; }
.cg-bar-fill.h2 { height: 90px; }
.cg-bar-fill.h3 { height: 78px; }
.cg-bar-fill.h4 { height: 114px; }
.cg-bar-fill.h5 { height: 102px; }
.cg-bar-fill.h6 { height: 126px; }
.cg-bar-fill.h7 { height: 144px; }


.cg-card-body-chart {
    flex-grow: 1;
    padding: 14px;
    min-height: 0;
}

.cg-bar-chart-wrap {
    flex-grow: 1;
    width: 100%;
    min-height: 280px;
    border-width: 1px;
    border-color: #e2e8f5;
