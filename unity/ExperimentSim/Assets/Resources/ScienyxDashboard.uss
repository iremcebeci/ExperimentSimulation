}

.cg-bar-value {
    margin-bottom: 6px;
    font-size: 11px;
    color: #6e7da0;
    -unity-font-style: bold;
}

.cg-bar-track {
    width: 22px;
    height: 180px;
    background-color: #e8eef9;
