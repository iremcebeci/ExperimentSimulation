<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="ScienyxDashboard.uss" />

    <ui:VisualElement name="Root" class="root">

        <ui:VisualElement name="Sidebar" class="sidebar">

            <ui:ScrollView name="Menu" class="menu" vertical-scroller-visibility="Hidden"
                horizontal-scroller-visibility="Hidden">

                <ui:VisualElement name="SidebarHeaderItem" class="sidebar-header-item">
                    <ui:Label name="LogoLabel" class="logo" text="Scienyx" />
                    <ui:Button name="ToggleButton" class="toggle-btn">
                        <ui:VisualElement name="ToggleIcon" class="menu-icon icon-chevron" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- anasayfa -->
                <ui:Button name="HomeBtn" class="menu-item active">
                    <ui:VisualElement name="HomeIcon" class="menu-icon icon-home" />
                    <ui:Label name="HomeLabel" class="menu-text" text="Anasayfa" />
                </ui:Button>

                <!-- sınıflarım -->
                <ui:Button name="ClassBtn" class="menu-item">
                    <ui:VisualElement name="ClassIcon" class="menu-icon icon-class" />
                    <ui:Label name="ClassLabel" class="menu-text" text="Sınıflarım" />
                </ui:Button>

                <!-- ödev ekle -->
                <ui:Button name="AddAssignmentBtn" class="menu-item">
                    <ui:VisualElement name="AddAssignmentIcon" class="menu-icon icon-assignment" />
                    <ui:Label name="AddAssignmentLabel" class="menu-text" text="Ödev Ekle" />
                </ui:Button>


                <!-- 
                <ui:Button name="CalendarBtn" class="menu-item">
                    <ui:VisualElement name="CalendarIcon" class="menu-icon icon-calendar" />
                    <ui:Label name="CalendarLabel" class="menu-text"
                        text="Takvim" />
                </ui:Button>

                
                <ui:Button name="EmailBtn" class="menu-item">
                    <ui:VisualElement name="EmailIcon" class="menu-icon icon-email" />
                    <ui:Label name="EmailLabel" class="menu-text"
                        text="E Posta" />
                </ui:Button>
                -->

                <!-- aktivite -->
                <ui:Button name="ActivityBtn" class="menu-item">
                    <ui:VisualElement name="ActivityIcon" class="menu-icon icon-activity" />
                    <ui:Label name="ActivityLabel" class="menu-text"
                        text="Aktivite" />
                </ui:Button>

                <!-- profil -->
                <ui:Button name="ProfileBtn" class="menu-item">
                    <ui:VisualElement name="ProfileIcon" class="menu-icon icon-profile" />
                    <ui:Label name="ProfileLabel" class="menu-text"
                        text="Profil" />
                </ui:Button>

                <!-- simülasyon -->
                <ui:Button name="StartSimulationBtn" class="menu-item">
                    <ui:VisualElement name="StartSimulationIcon" class="menu-icon icon-sim" />
                    <ui:Label name="StartSimulationLabel" class="menu-text"
                        text="Simülasyonu Başlat" />
                </ui:Button>

            </ui:ScrollView>

            <!-- çıkış yap -->
            <ui:VisualElement name="SidebarFooter" class="sidebar-footer">
                <ui:Button name="LogoutBtn" class="menu-item btnLogout">
                    <ui:VisualElement name="LogoutIcon" class="menu-icon icon-logout" />
                    <ui:Label name="LogoutLabel" class="menu-text" text="Çıkış Yap" />
                </ui:Button>

                <ui:Image name="BrandLogo" class="brand-logo-img" />
            </ui:VisualElement>

        </ui:VisualElement>


        <!-- main -->
        <ui:VisualElement name="main" class="main">

            <ui:VisualElement name="MainContent" class="teacher-main-content">

                <ui:VisualElement class="dashboards-top">

                    <ui:VisualElement class="dasboard-user-info">
                        <ui:Label name="TopUsernameLabel" text="-" class="dashboards-top-username" />
                        <ui:Label text="|" class="dashboards-top-divider" />
                        <ui:Label name="TopRoleLabel" text="-" class="dashboards-top-title" />
                    </ui:VisualElement>

                    <ui:VisualElement class="top-navigation">

                        <ui:Button name="SettingsBtn" class="" text="">
                            <ui:VisualElement name="SettingsIcon" class="top-nav-icon icon-settings" />
                        </ui:Button>

                        <ui:Button name="NotificationsBtn" class="" text="">
                            <ui:VisualElement name="NotificationsIcon"
                                class="top-nav-icon icon-bell" />
                        </ui:Button>

                        <ui:Button name="AccountBtn" class="" text="">
                            <ui:VisualElement name="AccountIcon" class="top-nav-icon icon-user" />
                        </ui:Button>

                    </ui:VisualElement>
                </ui:VisualElement>


                <!-- anasayfa -->
                <ui:VisualElement name="HomePage" class="page active">
                    <ui:VisualElement class="welcome-area">

                        <ui:VisualElement class="welcome-text">
                            <ui:Label name="WelcomeUsernameLabel" text="Merhaba, -"
                                class="welcome-username" />
                            <ui:VisualElement class="br" />
                            <ui:Label name="WelcomeMessageLabel" text="-" class="welcome-message" />
                        </ui:VisualElement>

                        <ui:VisualElement class="welcome-hero" />

                    </ui:VisualElement>

                    <ui:VisualElement name="TeacherHomePage" class="tc-home">

                        <!-- KPI -->
                        <ui:VisualElement class="tc-kpi-grid">

                            <ui:VisualElement class="tc-kpi-card">
                                <ui:Label text="TS" class="tc-kpi-icon navy" />
                                <ui:VisualElement class="tc-kpi-texts">
                                    <ui:Label name="TcTotalClassValueLabel" text="-"
                                        class="tc-kpi-value" />
                                    <ui:Label text="Toplam Sınıf" class="tc-kpi-label" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="tc-kpi-card">
                                <ui:Label text="TÖ" class="tc-kpi-icon blue" />
                                <ui:VisualElement class="tc-kpi-texts">
                                    <ui:Label name="TcTotalStudentValueLabel" text="-"
                                        class="tc-kpi-value" />
                                    <ui:Label text="Toplam Öğrenci" class="tc-kpi-label" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="tc-kpi-card">
                                <ui:Label text="AÖ" class="tc-kpi-icon amber" />
                                <ui:VisualElement class="tc-kpi-texts">
                                    <ui:Label name="TcActiveAssignmentValueLabel" text="-"
                                        class="tc-kpi-value" />
                                    <ui:Label text="Aktif Ödevler" class="tc-kpi-label" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="tc-kpi-card">
                                <ui:Label text="TÖD" class="tc-kpi-icon green" />
                                <ui:VisualElement class="tc-kpi-texts">
                                    <ui:Label name="TcCompletedAssignmentValueLabel" text="-"
                                        class="tc-kpi-value" />
                                    <ui:Label text="Tamamlanan Ödevler" class="tc-kpi-label" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                        </ui:VisualElement>

                        <!-- Alt Alan -->
                        <ui:VisualElement class="tc-main-grid">

                            <!-- Sol Panel -->
                            <ui:VisualElement class="tc-panel tc-summary-panel">
                                <ui:VisualElement class="tc-panel-head">
                                    <ui:Label text="Özet" class="tc-panel-title" />
                                    <ui:Label text="Canlı Durum" class="tc-panel-badge" />
                                </ui:VisualElement>

                                <ui:ScrollView name="TcSummaryScroll" class="tc-summary-scroll"
                                    mode="Vertical">

                                    <ui:VisualElement class="tc-summary-item">
                                        <ui:Label text="En Aktif Sınıf" class="tc-summary-small" />
                                        <ui:Label name="TcMostActiveClassLabel"
                                            text="-" class="tc-summary-bold" />
                                        <ui:Label text="-"
                                            class="tc-summary-text" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="tc-summary-item">
                                        <ui:Label text="Bu Hafta En Çok Ödev Tamamlayan Sınıf"
                                            class="tc-summary-small" />
                                        <ui:Label name="TcTopHomeworkClassLabel"
                                            text="-" class="tc-summary-bold" />
                                        <ui:Label text="-"
                                            class="tc-summary-text" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="tc-summary-item">
                                        <ui:Label text="Son Eklenen Sınıf"
                                            class="tc-summary-small" />
                                        <ui:Label name="TcTopHomeworkClassLabel"
                                            text="-" class="tc-summary-bold" />
                                        <ui:Label text="-"
                                            class="tc-summary-text" />
                                    </ui:VisualElement>

                                </ui:ScrollView>
                            </ui:VisualElement>

                            <!-- Sağ Panel -->
                            <ui:VisualElement class="tc-panel tc-chart-panel">
                                <ui:VisualElement class="tc-panel-head">
                                    <ui:Label text="Sınıf Aktiflik Grafiği" class="tc-panel-title" />
                                    <ui:Label text="Haftalık Görünüm" class="tc-panel-badge" />
                                </ui:VisualElement>

                                <ui:VisualElement class="tc-chart-wrap">
                                    <ui:VisualElement name="TeacherActivityChart"
                                        class="tc-chart-box">

                                        <ui:VisualElement
                                            class="tc-chart-grid-line tc-chart-grid-top" />
                                        <ui:VisualElement
                                            class="tc-chart-grid-line tc-chart-grid-mid" />
                                        <ui:VisualElement
                                            class="tc-chart-grid-line tc-chart-grid-low" />

                                        <ui:VisualElement class="tc-chart-bars">
                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarMon"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Pzt" class="tc-chart-x-label" />
                                            </ui:VisualElement>

                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarTue"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Sal" class="tc-chart-x-label" />
                                            </ui:VisualElement>

                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarWed"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Çar" class="tc-chart-x-label" />
                                            </ui:VisualElement>

                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarThu"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Per" class="tc-chart-x-label" />
                                            </ui:VisualElement>

                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarFri"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Cum" class="tc-chart-x-label" />
                                            </ui:VisualElement>

                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarSat"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Cmt" class="tc-chart-x-label" />
                                            </ui:VisualElement>

                                            <ui:VisualElement class="tc-chart-bar-group">
                                                <ui:Label text="0" class="cg-bar-value" />
                                                <ui:VisualElement name="TcBarSun"
                                                    class="tc-chart-bar" />
                                                <ui:Label text="Paz" class="tc-chart-x-label" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>

                                    </ui:VisualElement>

                                    <ui:VisualElement class="tc-chart-legend">
                                        <ui:VisualElement class="tc-chart-legend-left">
                                            <ui:VisualElement class="tc-chart-legend-line" />
                                            <ui:Label text="Aktif Saat"
                                                class="tc-chart-legend-text" />
                                        </ui:VisualElement>

                                        <ui:Label name="TcChartPeakInfoLabel" text="Tepe: -"
                                            class="tc-chart-legend-peak" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>

                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:VisualElement>


                <!-- t-class-statistics -->
                <ui:VisualElement name="ClassesPage" class="page">

                    <ui:VisualElement class="t-class-statistics">

                        <ui:VisualElement class="t-class-statistics-item ">
                            <ui:VisualElement class="t-class-statistics-top">
                                <ui:Label text="Aktif Sınıf Sayısı" />
                            </ui:VisualElement>
                            <ui:VisualElement class="t-class-statistics-bottom">
                                <ui:Label name="ActiveClassCountLabel" text="-" class="result" />
                                <ui:VisualElement class="legacy-statistics">
                                    <ui:Label text="Toplam Sınıf Sayısı" />

                                    <ui:Label name="TotalClassCountLabel" text="-"
                                        class="total-result" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="t-class-statistics-item">
                            <ui:VisualElement class="t-class-statistics-top">
                                <ui:Label text="Mevcut Öğrenci Sayısı" />
                            </ui:VisualElement>
                            <ui:VisualElement class="t-class-statistics-bottom">
                                <ui:Label name="ActiveStudentCountLabel" text="-" class="result" />
                                <ui:VisualElement class="legacy-statistics">
                                    <ui:Label text="Toplam Öğrenci Sayısı" />
                                    <ui:Label name="TotalStudentCountLabel" text="-"
                                        class="total-result" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="t-class-statistics-item">
                            <ui:VisualElement class="t-class-statistics-top">
                                <ui:Label text="Öğrenci Başarı Durumu" />
                            </ui:VisualElement>
                            <ui:VisualElement class="t-class-statistics-bottom">
                                <ui:Label name="ClassSuccessRateLabel" text="%0" class="result" />
                                <ui:VisualElement class="legacy-statistics">
                                    <ui:Label text="En Başarılı Sınıf" />
                                    <ui:Label name="TopClassNameLabel" text="-" class="total-result" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="t-class-statistics-item">
                            <ui:VisualElement class="t-class-statistics-top">
                                <ui:Label text="Son Ödevin Tamamlanma Oranı" />
                            </ui:VisualElement>
                            <ui:VisualElement class="t-class-statistics-bottom">
                                <ui:Label name="LatestAssignmentCompletionRateLabel" text="%0" class="result" />
                                <ui:VisualElement class="legacy-statistics">
                                    <ui:Label text="Teslim Edilen / Edilmeyen" />
                                    <ui:Label name="LatestAssignmentDeliverySplitLabel" text="0 / 0" class="total-result" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- classes-container -->
                    <ui:VisualElement class="classes-container">
                        <ui:VisualElement class="classes-top">

                            <ui:VisualElement class="search-box">
                                <ui:VisualElement class="icon icon-search" />
                                <ui:TextField name="searchInput" class="" value="" />

                            </ui:VisualElement>

                            <ui:VisualElement class="add-class-side">
                                <ui:Button name="AddClassBtn" class="add-class-btn"
                                    text="Sınıf Ekle" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- label.filter-check + checkbox -->
                        <ui:VisualElement class="filter-check">
                            <ui:Toggle name="includeInactive"
                                text="Aktif olmayan sınıfları da getir." />
                        </ui:VisualElement>

                        <!-- classes-bottom -->
                        <ui:ScrollView name="ClassesScroll" class="classes-bottom"
                            vertical-scroller-visibility="Auto"
                            horizontal-scroller-visibility="Hidden">

                            <!-- header row -->
                            <ui:VisualElement class="classes-header-row">
                                <ui:VisualElement class="col class-name">
                                    <ui:Label text="Sınıf" />
                                </ui:VisualElement>
                                <ui:VisualElement class="col class-lesson">
                                    <ui:Label text="Ders" />
                                </ui:VisualElement>
                                <ui:VisualElement class="col class-code">
                                    <ui:Label text="Sınıf Kodu" />
                                </ui:VisualElement>
                                <ui:VisualElement class="col class-student">
                                    <ui:Label text="Öğrenci Sayısı" />
                                </ui:VisualElement>
                                <ui:VisualElement class="col class-assignment">
                                    <ui:Label text="Ödev Sayısı" />
                                </ui:VisualElement>
                                <ui:VisualElement class="col class-success">
                                    <ui:Label text="Başarı Oranı" />
                                </ui:VisualElement>
                                <ui:VisualElement class="col class-status">
                                    <ui:Label text="Durum" />
                                </ui:VisualElement>
                                <ui:VisualElement class="col class-actions">
                                    <ui:Label text="İşlemler" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- buraya satırları C# ile basacağız -->
                            <ui:VisualElement name="ClassesRows" />

                        </ui:ScrollView>

                    </ui:VisualElement>

                    <!-- addClassModal -->
                    <ui:VisualElement name="addClassModal" class="modal-backdrop">
                        <ui:VisualElement class="modal">

                            <ui:VisualElement class="modal-header">
                                <ui:Label name="modalTitle" text="Sınıf Ekle" />
                                <ui:Button name="AddClassModalCloseBtn" class="modal-close" text="×" />
                            </ui:VisualElement>

                            <ui:VisualElement class="modal-body">

                                <ui:VisualElement class="form-row">
                                    <ui:Label text="Sınıf Adı" />
                                    <ui:TextField name="classNameInput" class="" value="" />
                                </ui:VisualElement>

                                <ui:VisualElement class="form-row">
                                    <ui:Label text="Kademe / Sınıf Seviyesi" />
                                    <ui:DropdownField name="gradeLevelDropdown" class="" />
                                </ui:VisualElement>

                                <ui:VisualElement class="form-row">
                                    <ui:Label text="Ders" />
                                    <ui:TextField name="lessonInput" class="" value="" />
                                    <ui:VisualElement name="lessonOptions" class="">
                                    </ui:VisualElement>
                                </ui:VisualElement>

                            </ui:VisualElement>

                            <ui:VisualElement class="modal-footer">
                                <ui:Button name="AddClassCancelBtn" class="btn-secondary"
                                    text="İptal" />
                                <ui:Button name="saveClassBtn" class="btn-primary" text="Kaydet" />
                            </ui:VisualElement>

                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>


                <!-- ödev ekle -->
                <ui:VisualElement name="AddAssignmentPage" class="page">

                    <ui:VisualElement class="add-assignment-top">
                        <ui:Label
                            name="AddAssignmentInfoLabel"
                            class="information-text"
                            text="Ödev eklemek için bir güne tıklayın." />

                        <ui:VisualElement class="day-buttons">
                            <ui:Button name="AssignmentPastBtn" class="assignment-nav-btn" text="◀" />
                            <ui:Button name="AssignmentNextBtn" class="assignment-nav-btn" text="▶" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="TimelineAssignment" class="timeline-assignment">

                        <!-- üst günler -->
                        <ui:VisualElement name="TimelineDays" class="timeline-days" />

                        <!-- alt satırlar -->
                        <ui:VisualElement name="TimelineContents" class="timeline-contents" />

                    </ui:VisualElement>

                    <!-- modal -->
                    <ui:VisualElement name="AssignmentModal" class="assignment-modal hidden">

                        <ui:VisualElement name="AssignmentModalCard" class="assignment-modal-card">

                            <ui:VisualElement class="assignment-modal-top">
                                <ui:Label text="Ödev Ekle" class="assignment-modal-title" />
                                <ui:Button name="CloseAssignmentModalBtn"
                                    class="close-assignment-modal-btn" text="×" />
                            </ui:VisualElement>

                            <ui:VisualElement class="assignment-form">

                                <ui:VisualElement class="form-group">
                                    <ui:Label text="Ödev Başlığı" class="form-group-label" />
                                    <ui:TextField name="AssignmentTitleField"
                                        class="assignment-input" />
                                </ui:VisualElement>

                                <ui:VisualElement class="form-group">
                                    <ui:Label text="Sınıf" class="form-group-label" />
                                    <ui:DropdownField name="AssignmentClassDropdown"
                                        class="assignment-input" />
                                </ui:VisualElement>

                                <ui:VisualElement class="form-group">
                                    <ui:Label text="Ders" class="form-group-label" />
                                    <ui:DropdownField name="AssignmentLessonDropdown"
                                        class="assignment-input" />
                                </ui:VisualElement>

                                <ui:VisualElement class="form-group">
                                    <ui:Label text="Ünite" class="form-group-label" />
                                    <ui:DropdownField name="AssignmentUnitDropdown"
                                        class="assignment-input" />
                                </ui:VisualElement>

                                <ui:VisualElement class="form-group">
                                    <ui:Label text="Deney" class="form-group-label" />
                                    <ui:DropdownField name="AssignmentExperimentDropdown"
                                        class="assignment-input" />
                                </ui:VisualElement>

                                <ui:VisualElement class="form-group">
                                    <ui:Label text="Başlangıç Günü" class="form-group-label" />
                                    <ui:TextField name="AssignmentStartField"
                                        class="assignment-input" is-read-only="true" />
                                </ui:VisualElement>

                                <ui:VisualElement class="form-group">
                                    <ui:Label text="Süre (gün)" class="form-group-label" />
                                    <ui:IntegerField name="AssignmentDurationField"
                                        class="assignment-input" value="1" />
                                </ui:VisualElement>

                                <ui:VisualElement class="form-actions">
                                    <ui:Button name="CancelAssignmentBtn" class="cancel-btn"
                                        text="İptal" />
                                    <ui:Button name="SaveAssignmentBtn" class="save-btn"
                                        text="Kaydet" />
                                </ui:VisualElement>

                            </ui:VisualElement>

                        </ui:VisualElement>

                    </ui:VisualElement>

                    <ui:VisualElement name="AssignmentDetailsModal" class="assignment-modal hidden">
                        <ui:VisualElement class="assignment-modal-card">
                            <ui:VisualElement class="assignment-modal-top">
                                <ui:Label text="Ödev Detayı" class="assignment-modal-title" />
                                <ui:Button name="AssignmentDetailsCloseBtn"
                                    class="close-assignment-modal-btn" text="×" />
                            </ui:VisualElement>

                            <ui:VisualElement class="assignment-form">
                                <ui:VisualElement class="form-group">
                                    <ui:Label text="Başlık" class="form-group-label" />
                                    <ui:Label name="AssignmentDetailsTitle" text="-"
                                        class="assignment-input" />
                                </ui:VisualElement>
                                <ui:VisualElement class="form-group">
                                    <ui:Label text="Sınıf" class="form-group-label" />
                                    <ui:Label name="AssignmentDetailsClass" text="-"
                                        class="assignment-input" />
                                </ui:VisualElement>
                                <ui:VisualElement class="form-group">
                                    <ui:Label text="Ders" class="form-group-label" />
                                    <ui:Label name="AssignmentDetailsLesson" text="-"
                                        class="assignment-input" />
                                </ui:VisualElement>
                                <ui:VisualElement class="form-group">
                                    <ui:Label text="Başlangıç" class="form-group-label" />
                                    <ui:Label name="AssignmentDetailsStart" text="-"
                                        class="assignment-input" />
                                </ui:VisualElement>
                                <ui:VisualElement class="form-group">
                                    <ui:Label text="Süre" class="form-group-label" />
                                    <ui:Label name="AssignmentDetailsDuration" text="-"
                                        class="assignment-input" />
                                </ui:VisualElement>
                                <ui:VisualElement class="form-group">
                                    <ui:Label text="Deney" class="form-group-label" />
                                    <ui:Label name="AssignmentDetailsExperiment" text="-"
                                        class="assignment-input" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>


                <!-- sınıf detayları sayfası -->
                <ui:VisualElement name="ClassDetailsPage" class="page">

                    <!-- üst bilgi kartı -->
                    <ui:VisualElement class="class-details-card">

                        <ui:VisualElement class="class-details-column cd-box">
                            <ui:VisualElement class="class-details-row cd-title-row">
                                <ui:Label text="Sınıf Adı ve Dersi" class="cd-title" />
                            </ui:VisualElement>
                            <ui:VisualElement class="class-details-row cd-box-row">
                                <ui:Label name="CdClassNameLabel" text="11/C FİZİK"
                                    class="cd-box-main-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="class-details-column">
                            <ui:VisualElement class="class-details-row">
                                <ui:Label text="Öğretmen Adı" class="class-details-title" />
                                <ui:Label name="CdTeacherNameLabel" text="Ruveyda Bilim"
                                    class="class-details-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="class-details-row">
