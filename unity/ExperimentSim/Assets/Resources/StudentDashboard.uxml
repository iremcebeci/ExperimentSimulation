                                        <ui:VisualElement name="OverallFillBar"
                                            class="progress-bar-fill progress-fill-45" />
                                    </ui:VisualElement>

                                    <ui:Label text="Tüm dersler dahil" class="progress-bar-sub" />
                                </ui:VisualElement>

                                <ui:VisualElement class="progress-bar-card">
                                    <ui:VisualElement class="progress-bar-header">
                                        <ui:Label name="SubjectProgressLabel"
                                            text="Fen Bilimleri İlerlemesi"
                                            class="progress-bar-label" />
                                        <ui:Label name="SubjectPercentLabel" text="%52"
                                            class="progress-bar-percent" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="progress-bar-track">
                                        <ui:VisualElement name="SubjectFillBar"
                                            class="progress-bar-fill progress-fill-52" />
                                    </ui:VisualElement>

                                    <ui:Label name="SubjectSubLabel"
                                        text="9 deney tamamlandı — 8 devam ediyor"
                                        class="progress-bar-sub" />
                                </ui:VisualElement>

                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Search & Filter -->
                        <ui:VisualElement class="progress-filter-strip">

                            <ui:VisualElement class="progress-search">
                                <ui:VisualElement class="icon icon-search icon-pr" />
                                <ui:TextField name="ProgressSearchField"
                                    class="progress-search-input" />
                            </ui:VisualElement>

                            <ui:DropdownField
                                name="ProgressStatusDropdown"
                                class="progress-filter-select"
                                choices="Tüm Durumlar,Başlanmadı,Devam Ediyor,Tamamlandı"
                                index="0" />

                            <ui:DropdownField
                                name="ProgressDifficultyDropdown"
                                class="progress-filter-select"
                                choices="Tüm Zorluklar,Kolay,Orta,Zor"
                                index="0" />

                        </ui:VisualElement>

                        <!-- 3 Column Layout -->
                        <ui:VisualElement class="progress-columns">

                            <!-- Başlanmadı -->
                            <ui:VisualElement class="progress-column">
                                <ui:VisualElement class="progress-column-header">
                                    <ui:VisualElement class="progress-column-dot not-started" />
                                    <ui:Label text="Başlanmadı" class="progress-column-title" />
                                    <ui:Label text="4" class="progress-column-count" />
                                </ui:VisualElement>

                                <ui:ScrollView name="ProgressNotStartedScroll"
                                    class="progress-column-scroll" mode="Vertical">
                                    <ui:VisualElement class="exp-card">
                                        <ui:VisualElement class="exp-card-top">
                                            <ui:Label text="Işığın Kırılması" class="exp-card-title" />
                                            <ui:Label text="Kolay" class="exp-card-badge easy" />
                                        </ui:VisualElement>
                                        <ui:Label
                                            text="Farklı ortamlarda ışığın kırılma açısını gözlemleyin."
                                            class="exp-card-desc" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="exp-card">
                                        <ui:VisualElement class="exp-card-top">
                                            <ui:Label text="Asit-Baz Tepkimeleri"
                                                class="exp-card-title" />
                                            <ui:Label text="Orta" class="exp-card-badge medium" />
                                        </ui:VisualElement>
                                        <ui:Label
                                            text="pH göstergesi ile asit ve bazları ayırt edin."
                                            class="exp-card-desc" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="exp-card">
                                        <ui:VisualElement class="exp-card-top">
                                            <ui:Label text="Elektromanyetik İndüksiyon"
                                                class="exp-card-title" />
                                            <ui:Label text="Zor" class="exp-card-badge hard" />
                                        </ui:VisualElement>
                                        <ui:Label
                                            text="Manyetik alan değişimi ile indüksiyon akımını inceleyin."
                                            class="exp-card-desc" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="exp-card exp-card-locked">
                                        <ui:VisualElement class="exp-card-top">
                                            <ui:Label text="🔒 Nükleer Fisyon"
                                                class="exp-card-title" />
                                            <ui:Label text="Zor" class="exp-card-badge hard" />
                                        </ui:VisualElement>
                                        <ui:Label
                                            text="Bu deneye erişmek için önceki deneyleri tamamlayın."
                                            class="exp-card-desc" />
                                    </ui:VisualElement>
                                </ui:ScrollView>
                            </ui:VisualElement>

                            <!-- Devam Ediyor -->
                            <ui:VisualElement class="progress-column">
                                <ui:VisualElement class="progress-column-header">
                                    <ui:VisualElement class="progress-column-dot in-progress" />
                                    <ui:Label text="Devam Ediyor" class="progress-column-title" />
                                    <ui:Label text="3" class="progress-column-count" />
                                </ui:VisualElement>

                                <ui:ScrollView name="ProgressInProgressScroll"
                                    class="progress-column-scroll" mode="Vertical">
                                    <ui:VisualElement class="exp-card">
                                        <ui:VisualElement class="exp-card-top">
                                            <ui:Label text="Basit Makineler" class="exp-card-title" />
                                            <ui:Label text="Kolay" class="exp-card-badge easy" />
                                        </ui:VisualElement>

                                        <ui:VisualElement class="exp-card-progress">
                                            <ui:VisualElement class="exp-card-progress-row">
                                                <ui:Label text="İlerleme"
                                                    class="exp-card-progress-label" />
                                                <ui:Label text="%72" class="exp-card-progress-val" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="exp-card-track">
                                                <ui:VisualElement class="exp-card-fill exp-fill-72" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>

                                    <ui:VisualElement class="exp-card">
                                        <ui:VisualElement class="exp-card-top">
                                            <ui:Label text="Elektrik Devreleri"
                                                class="exp-card-title" />
                                            <ui:Label text="Orta" class="exp-card-badge medium" />
                                        </ui:VisualElement>

                                        <ui:VisualElement class="exp-card-progress">
                                            <ui:VisualElement class="exp-card-progress-row">
                                                <ui:Label text="İlerleme"
                                                    class="exp-card-progress-label" />
                                                <ui:Label text="%38" class="exp-card-progress-val" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="exp-card-track">
                                                <ui:VisualElement class="exp-card-fill exp-fill-38" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>

                                    <ui:VisualElement class="exp-card">
                                        <ui:VisualElement class="exp-card-top">
                                            <ui:Label text="Kuvvet ve Hareket"
                                                class="exp-card-title" />
                                            <ui:Label text="Orta" class="exp-card-badge medium" />
                                        </ui:VisualElement>

                                        <ui:VisualElement class="exp-card-progress">
                                            <ui:VisualElement class="exp-card-progress-row">
                                                <ui:Label text="İlerleme"
                                                    class="exp-card-progress-label" />
                                                <ui:Label text="%15" class="exp-card-progress-val" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="exp-card-track">
                                                <ui:VisualElement class="exp-card-fill exp-fill-15" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:ScrollView>
                            </ui:VisualElement>

                            <!-- Tamamlandı -->
                            <ui:VisualElement class="progress-column">
                                <ui:VisualElement class="progress-column-header">
                                    <ui:VisualElement class="progress-column-dot completed" />
                                    <ui:Label text="Tamamlandı" class="progress-column-title" />
                                    <ui:Label text="3" class="progress-column-count" />
                                </ui:VisualElement>

                                <ui:ScrollView name="ProgressCompletedScroll"
                                    class="progress-column-scroll" mode="Vertical">
                                    <ui:VisualElement class="exp-card">
                                        <ui:VisualElement class="exp-card-top">
                                            <ui:Label text="Serbest Düşme" class="exp-card-title" />
                                            <ui:Label text="✓" class="exp-card-complete-icon" />
                                        </ui:VisualElement>
                                        <ui:Label text="Yerçekimi etkisinde serbest düşme hareketi."
                                            class="exp-card-desc" />
                                        <ui:Label text="Skor: %94" class="exp-card-score" />
                                        <ui:Button name="ReviewFreeFallBtn" text="İncele"
                                            class="exp-card-btn review" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="exp-card">
                                        <ui:VisualElement class="exp-card-top">
                                            <ui:Label text="Kaldıraçlar" class="exp-card-title" />
                                            <ui:Label text="✓" class="exp-card-complete-icon" />
                                        </ui:VisualElement>
                                        <ui:Label
                                            text="1., 2. ve 3. tür kaldıraçların karşılaştırması."
                                            class="exp-card-desc" />
                                        <ui:Label text="Skor: %88" class="exp-card-score" />
                                        <ui:Button name="ReviewLeversBtn" text="İncele"
                                            class="exp-card-btn review" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="exp-card">
                                        <ui:VisualElement class="exp-card-top">
                                            <ui:Label text="Mıknatıslar" class="exp-card-title" />
                                            <ui:Label text="✓" class="exp-card-complete-icon" />
                                        </ui:VisualElement>
                                        <ui:Label
                                            text="Manyetik alan çizgileri ve kutuplar arası etkileşim."
                                            class="exp-card-desc" />
                                        <ui:Label text="Skor: %91" class="exp-card-score" />
                                        <ui:Button name="ReviewMagnetsBtn" text="İncele"
                                            class="exp-card-btn review" />
                                    </ui:VisualElement>
                                </ui:ScrollView>
                            </ui:VisualElement>

                        </ui:VisualElement>

                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- TAKVİM -->
                <ui:VisualElement name="CalendarPage" class="page cal-page">

                    <ui:VisualElement class="cal-page-wrapper">

                        <!-- Header -->
                        <ui:VisualElement class="cal-page-header">
                            <ui:VisualElement class="cal-page-header-left">
                                <ui:Label text="Takvim" class="cal-page-title" />
                                <ui:Label
                                    text="Ders programlarını, sınav tarihlerini, toplantıları ve akademik etkinlikleri yönetin."
                                    class="cal-page-subtitle" />
                            </ui:VisualElement>

                            <ui:VisualElement class="cal-page-header-actions">
                                <ui:Button name="CalAddEventBtn" class="cal-btn cal-btn-primary"
                                    text="Etkinlik Ekle" />
                                <ui:Button name="CalRefreshBtn" class="cal-btn cal-btn-outline"
                                    text="Yenile" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Toolbar -->
                        <ui:VisualElement class="cal-toolbar">
                            <ui:VisualElement class="cal-toolbar-nav">
                                <ui:Button name="CalPrevBtn" class="cal-btn-icon" text="‹" />
                                <ui:Label name="CalToolbarMonthLabel" text="Mart 2026"
                                    class="cal-toolbar-month" style="-unity-text-align: middle-center;"/>
                                <ui:Button name="CalNextBtn" class="cal-btn-icon" text="›" />
                                <ui:Button name="CalTodayBtn" class="cal-btn cal-btn-outline"
                                    text="Bugün" />
                            </ui:VisualElement>

                            <ui:VisualElement class="cal-toolbar-views">
                                <ui:Button name="CalViewDayBtn" class="cal-view-btn" text="Gün" />
                                <ui:Button name="CalViewWeekBtn" class="cal-view-btn" text="Hafta" />
                                <ui:Button name="CalViewMonthBtn" class="cal-view-btn active"
                                    text="Ay" />
                                <ui:Button name="CalViewAgendaBtn" class="cal-view-btn"
                                    text="Ajanda" />
                            </ui:VisualElement>

                            <ui:VisualElement class="cal-toolbar-right">
                                <ui:VisualElement class="assignment-search cal-calendar-search">
                                    <ui:VisualElement class="icon icon-search" />
                                    <ui:TextField name="CalSearchInput" />
                                </ui:VisualElement>

                                <ui:DropdownField
                                    name="CalFilterDropdown"
                                    class="cal-filter-select"
                                    choices="Tüm Etkinlikler"
                                    index="0" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Body -->
                        <ui:VisualElement class="cal-body">

                            <!-- Left -->
                            <ui:ScrollView name="CalSidePanel" class="cal-side-panel"
                                mode="Vertical">

                                <!-- Mini Calendar -->
                                <ui:VisualElement class="cal-side-card">
                                    <ui:VisualElement class="cal-mini-header">
                                        <ui:Button name="CalMiniPrevBtn" class="cal-mini-nav"
                                            text="‹" />
                                        <ui:Label name="CalMiniMonthLabel" text="Mart 2026" style="-unity-text-align: middle-center;" />
                                        <ui:Button name="CalMiniNextBtn" class="cal-mini-nav"
                                            text="›" />
                                    </ui:VisualElement>

                                    <ui:VisualElement name="CalMiniGrid" class="cal-mini-grid" />
                                </ui:VisualElement>

                                <!-- Categories -->
                                <ui:VisualElement class="cal-side-card">
                                    <ui:Label text="Etkinlik Kategorileri"
                                        class="cal-side-card-title" />
                                    <ui:VisualElement name="CalCategoryList" class="cal-cat-list" />
                                    <ui:Label
                                        name="CalCategoryEmptyLabel"
                                        text="Henüz kategori yok. Kategori ekleyin."
                                        class="cal-cat-empty" />
                                    <ui:Button name="CalAddCategoryBtn"
                                        class="cal-btn cal-btn-outline cal-full-btn"
                                        text="Kategori Ekle" />
                                </ui:VisualElement>

                                <!-- Quick Actions -->
                                <ui:VisualElement class="cal-side-card">
                                    <ui:Label text="Hızlı İşlemler" class="cal-side-card-title" />

                                    <ui:VisualElement class="cal-quick-actions">
                                        <ui:Button name="CalQuickCreateBtn"
                                            class="cal-btn cal-btn-primary cal-full-btn"
                                            text="Etkinlik Oluştur" />
                                        <ui:Button name="CalQuickCategoryBtn"
                                            class="cal-btn cal-btn-outline cal-full-btn"
                                            text="Kategori Ekle" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                            </ui:ScrollView>

                            <!-- Main Panel -->
                            <ui:ScrollView class="cal-main-panel"
                                mode="Vertical"
                                horizontal-scroller-visibility="Hidden"
                                vertical-scroller-visibility="Auto">

                                

                                <!-- MONTH VIEW -->
                                <ui:VisualElement name="CalMonthView" class="cal-month-view active">
                                    <ui:VisualElement class="cal-weekday-header">
                                        <ui:Label text="Pzt" class="cal-weekday-cell" />
                                        <ui:Label text="Sal" class="cal-weekday-cell" />
                                        <ui:Label text="Çar" class="cal-weekday-cell" />
                                        <ui:Label text="Per" class="cal-weekday-cell" />
                                        <ui:Label text="Cum" class="cal-weekday-cell" />
                                        <ui:Label text="Cmt" class="cal-weekday-cell" />
                                        <ui:Label text="Paz" class="cal-weekday-cell" />
                                    </ui:VisualElement>

                                    <ui:VisualElement name="CalMonthGrid" class="cal-month-grid" />
                                </ui:VisualElement>

                                <!-- WEEK VIEW -->
                                <ui:ScrollView name="CalWeekView" class="cal-week-view hidden"
                                    mode="Vertical">
                                    <ui:VisualElement name="CalWeekHeader" class="cal-week-header" />
                                    <ui:VisualElement name="CalWeekBody" class="cal-week-body" />
                                </ui:ScrollView>

                                <!-- DAY VIEW -->
                                <ui:ScrollView name="CalDayView" class="cal-day-view hidden"
                                    mode="Vertical">
                                    <ui:Label name="CalDayHeaderLabel" text="-"
                                        class="cal-day-header" />
                                    <ui:VisualElement class="cal-day-timeline">
                                        <ui:VisualElement name="CalDayTimeCol"
                                            class="cal-day-time-col" />
                                        <ui:VisualElement name="CalDayEventsCol"
                                            class="cal-day-events-col" />
                                    </ui:VisualElement>
                                </ui:ScrollView>

                                <!-- AGENDA VIEW -->
                                <ui:ScrollView name="CalAgendaView" class="cal-agenda-view hidden"
                                    mode="Vertical">
                                    <ui:VisualElement name="CalAgendaContent" />
                                </ui:ScrollView>

                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ADD EVENT MODAL -->
                    <ui:VisualElement name="CalAddModal" class="cal-modal-backdrop hidden">
                        <ui:VisualElement class="cal-modal">
                            <ui:VisualElement class="cal-modal-header">
                                <ui:Label text="Etkinlik Ekle" />
                                <ui:Button name="CalAddModalCloseBtn" class="cal-modal-close"
                                    text="×" />
                            </ui:VisualElement>

                            <ui:ScrollView class="cal-modal-body" mode="Vertical">

                                <ui:VisualElement class="cal-form-row">
                                    <ui:Label text="Etkinlik Başlığı" />
                                    <ui:TextField name="CalAddTitleInput" />
                                </ui:VisualElement>

                                <ui:VisualElement class="cal-form-inline">
                                    <ui:VisualElement class="cal-form-row">
                                        <ui:Label text="Etkinlik Türü" />
                                        <ui:DropdownField name="CalAddTypeDropdown" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="cal-form-row">
                                        <ui:Label text="Tarih (yyyy-MM-dd)" />
                                        <ui:TextField name="CalAddDateInput" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="cal-form-inline">
                                    <ui:VisualElement class="cal-form-row">
                                        <ui:Label text="Başlangıç Saati (HH:mm)" />
                                        <ui:TextField name="CalAddStartInput" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="cal-form-row">
                                        <ui:Label text="Bitiş Saati (HH:mm)" />
                                        <ui:TextField name="CalAddEndInput" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="cal-form-row">
                                    <ui:Label text="İlgili Sınıf" />
                                    <ui:DropdownField name="CalAddClassDropdown" />
                                </ui:VisualElement>

                                <ui:VisualElement class="cal-form-row">
                                    <ui:Label text="Açıklama" />
                                    <ui:TextField name="CalAddDescInput" multiline="true" />
                                </ui:VisualElement>

                            </ui:ScrollView>

                            <ui:VisualElement class="cal-modal-footer">
                                <ui:Button name="CalAddCancelBtn" class="cal-btn cal-btn-outline"
                                    text="İptal" />
                                <ui:Button name="CalSaveEventBtn" class="cal-btn cal-btn-primary"
                                    text="Kaydet" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ADD CATEGORY MODAL -->
                    <ui:VisualElement name="CalCategoryModal" class="cal-modal-backdrop hidden">
                        <ui:VisualElement class="cal-modal">
                            <ui:VisualElement class="cal-modal-header">
                                <ui:Label text="Kategori Ekle" />
                                <ui:Button name="CalCategoryModalCloseBtn" class="cal-modal-close"
                                    text="×" />
                            </ui:VisualElement>

                            <ui:VisualElement class="cal-modal-body">
                                <ui:VisualElement class="cal-form-row">
                                    <ui:Label text="Kategori Adı" />
                                    <ui:TextField name="CalCategoryNameInput" />
                                </ui:VisualElement>

                                <ui:VisualElement class="cal-form-row">
                                    <ui:Label text="Hazır Renkler" />
                                    <ui:VisualElement
                                        style="flex-direction: row; gap: 8px; flex-wrap: wrap; margin-top: 4px;">
                                        <ui:Button name="CalPresetColor01" text=""
                                            style="width: 24px; height: 24px; background-color: #2e86c1; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #c9c9c9; border-right-color: #c9c9c9; border-top-color: #c9c9c9; border-bottom-color: #c9c9c9;" />
                                        <ui:Button name="CalPresetColor02" text=""
                                            style="width: 24px; height: 24px; background-color: #16a085; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #c9c9c9; border-right-color: #c9c9c9; border-top-color: #c9c9c9; border-bottom-color: #c9c9c9;" />
                                        <ui:Button name="CalPresetColor03" text=""
                                            style="width: 24px; height: 24px; background-color: #27ae60; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #c9c9c9; border-right-color: #c9c9c9; border-top-color: #c9c9c9; border-bottom-color: #c9c9c9;" />
                                        <ui:Button name="CalPresetColor04" text=""
                                            style="width: 24px; height: 24px; background-color: #f39c12; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #c9c9c9; border-right-color: #c9c9c9; border-top-color: #c9c9c9; border-bottom-color: #c9c9c9;" />
                                        <ui:Button name="CalPresetColor05" text=""
                                            style="width: 24px; height: 24px; background-color: #e74c3c; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #c9c9c9; border-right-color: #c9c9c9; border-top-color: #c9c9c9; border-bottom-color: #c9c9c9;" />
                                        <ui:Button name="CalPresetColor06" text=""
                                            style="width: 24px; height: 24px; background-color: #8e44ad; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #c9c9c9; border-right-color: #c9c9c9; border-top-color: #c9c9c9; border-bottom-color: #c9c9c9;" />
                                        <ui:Button name="CalPresetColor07" text=""
                                            style="width: 24px; height: 24px; background-color: #34495e; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #c9c9c9; border-right-color: #c9c9c9; border-top-color: #c9c9c9; border-bottom-color: #c9c9c9;" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="cal-form-row">
                                    <ui:Label text="Renk (hex)" />
                                    <ui:TextField name="CalCategoryColorInput" value="" />
                                </ui:VisualElement>

                                <ui:VisualElement class="cal-form-row">
                                    <ui:Label text="Yazı Rengi" />
                                    <ui:VisualElement style="flex-direction: row; gap: 8px; margin-top: 4px;">
                                        <ui:Button name="CalTextColorWhiteBtn" text="Aa"
                                            style="width: 44px; height: 24px; background-color: #ffffff; color: #111111; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #c9c9c9; border-right-color: #c9c9c9; border-top-color: #c9c9c9; border-bottom-color: #c9c9c9;" />
                                        <ui:Button name="CalTextColorBlackBtn" text="Aa"
