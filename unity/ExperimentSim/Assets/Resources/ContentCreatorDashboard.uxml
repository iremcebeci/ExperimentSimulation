                                    <ui:VisualElement class="todo-item-meta">
                                        <ui:Label text="Düşük" class="todo-priority low" />
                                        <ui:Label text="23 Mart" class="todo-date" />
                                        <ui:Button name="TodoItem3EditBtn" text="Düzenle"
                                            class="todo-mini-btn edit" />
                                        <ui:Button name="TodoItem3DeleteBtn" text="Sil"
                                            class="todo-mini-btn delete" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="todo-item is-overdue">
                                    <ui:VisualElement class="todo-item-main">
                                        <ui:Toggle name="TodoItem4Check" class="todo-check" />
                                        <ui:VisualElement class="todo-item-copy">
                                            <ui:Label text="Asit baz görsellerini optimize et" />
                                            <ui:Label text="Son teslim tarihi geçti, önceliklendir." />
                                        </ui:VisualElement>
                                    </ui:VisualElement>

                                    <ui:VisualElement class="todo-item-meta">
                                        <ui:Label text="Yüksek" class="todo-priority high" />
                                        <ui:Label text="20 Mart" class="todo-date overdue" />
                                        <ui:Button name="TodoItem4EditBtn" text="Düzenle"
                                            class="todo-mini-btn edit" />
                                        <ui:Button name="TodoItem4DeleteBtn" text="Sil"
                                            class="todo-mini-btn delete" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                            </ui:ScrollView>
                        </ui:VisualElement>

                        <!-- sağ detay panel -->
                        <ui:VisualElement name="TodoDetailPanel" class="todo-detail-panel open">
                            <ui:Button name="CloseTodoPanelBtn" text="x" class="todo-panel-close" />

                            <ui:ScrollView class="todo-detail-scroll">

                                <ui:VisualElement class="todo-detail-head">
                                    <ui:Label name="TodoDetailTitleLabel"
                                        text="Yeni deney videosu için araştırma yap" />
                                    <ui:VisualElement class="todo-detail-meta">
                                        <ui:Label name="TodoDetailPriorityLabel" text="Yüksek"
                                            class="todo-priority high" />
                                        <ui:Label name="TodoDetailDateLabel" text="22 Mart" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="todo-detail-block">
                                    <ui:Label text="Açıklama" />
                                    <ui:TextField name="TodoDetailDescField"
                                        class="todo-quick-input" multiline="true" />
                                </ui:VisualElement>

                                <ui:VisualElement class="todo-detail-block">
                                    <ui:Label text="Not Alanı" />
                                    <ui:TextField name="TodoDetailNotesField"
                                        class="todo-quick-input" multiline="true" />
                                </ui:VisualElement>

                                <ui:VisualElement class="todo-detail-block">
                                    <ui:Label text="Alt Görevler" />
                                    <ui:VisualElement name="TodoSubtaskList"
                                        class="todo-subtask-list">

                                        <ui:VisualElement class="todo-subtask-item">
                                            <ui:Toggle value="false" />
                                            <ui:Label text="Deney araştırması yap" />
                                        </ui:VisualElement>

                                        <ui:VisualElement class="todo-subtask-item done">
                                            <ui:Toggle value="true" />
                                            <ui:Label text="Kaynakları incele" />
                                        </ui:VisualElement>

                                    </ui:VisualElement>

                                    <ui:VisualElement class="todo-subtask-add">
                                        <ui:TextField name="TodoSubtaskInput"
                                            class="todo-quick-input" label="" />
                                        <ui:Button name="AddSubtaskBtn" text="Ekle" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="todo-detail-block">
                                    <ui:Label text="Aksiyonlar" />
                                    <ui:VisualElement class="todo-detail-actions">
                                        <ui:Button name="SaveTodoBtn" text="Kaydet"
                                            class="todo-secondary-btn" />
                                        <ui:Button name="MarkDoneBtn" text="Tamamlandı İşaretle"
                                            class="todo-primary-btn" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                            </ui:ScrollView>
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:VisualElement>


                <!-- aktivite -->
                <ui:VisualElement name="ActivityPage" class="page">

                    <ui:ScrollView name="PersonalActivityScroll" class="activity-page"
                        mode="Vertical">

                        <!-- Filter Bar -->
                        <ui:VisualElement class="act-filter-bar">

                            <ui:VisualElement class="act-filter-tabs">
                                <ui:Button name="ActTabAllBtn" text="Tümü"
                                    class="act-filter-tab active" />
                                <ui:Button name="ActTabExperimentBtn" text="Sınıflar"
                                    class="act-filter-tab" />
                                <ui:Button name="ActTabMissionsBtn" text="İşler"
                                    class="act-filter-tab" />
                                <ui:Button name="ActTabProgressBtn" text="Hesap"
                                    class="act-filter-tab" />
                                <ui:Button name="ActTabParticipationBtn" text="Katılım"
                                    class="act-filter-tab" />
                            </ui:VisualElement>

                            <ui:VisualElement class="assignment-search">
                                <ui:VisualElement class="icon icon-search" />
                                <ui:TextField name="AssignmentSearchInput" class="" value="" />
                            </ui:VisualElement>

                            <ui:DropdownField
                                name="ActDateFilterDropdown"
                                class="act-date-select"
                                choices="Tüm Zamanlar,Bugün,Bu Hafta,Bu Ay"
                                index="0" />
                        </ui:VisualElement>

                        <!-- Main Layout -->
                        <ui:VisualElement class="act-main-layout">

                            <!-- Feed -->
                            <ui:VisualElement name="ActFeed" class="act-feed">
                                <ui:Label text="Aktivite yükleniyor..." class="act-date-divider" />

                            </ui:VisualElement>

                        </ui:VisualElement>
                    </ui:ScrollView>

                </ui:VisualElement>

                <!-- profil -->
                <ui:VisualElement name="ProfilePage" class="page">

                    <ui:ScrollView name="TeacherProfileScroll" class="teacher-profile-page"
                        mode="Vertical">
                        <ui:VisualElement class="teacher-profile-top">

                            <ui:VisualElement class="teacher-profile-card teacher-identity-section">
                                <ui:VisualElement class="teacher-avatar-area">
                                    <ui:Label name="TeacherAvatarLabel" text="-"
                                        class="teacher-avatar" />

                                    <ui:VisualElement class="teacher-name-area">
                                        <ui:Label name="TeacherNameLabel" text="-"
                                            class="teacher-name-title" />
                                        <ui:Label name="TeacherRoleLabel"
                                            text="-"
                                            class="teacher-role-badge" />

                                        <ui:VisualElement class="teacher-status-indicator">
                                            <ui:VisualElement class="teacher-status-dot" />
                                            <ui:Label name="TeacherStatusLabel" text="-"
                                                class="teacher-status-text" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="teacher-identity-divider" />

                                <ui:VisualElement class="teacher-info-grid">

                                    <ui:VisualElement
                                        class="teacher-info-item">
                                        <ui:Label text="Creator ID" class="teacher-info-caption" />
                                        <ui:Label name="TeacherCreatorIdLabel"
                                            text="-"
                                            class="teacher-info-value" />
                                    </ui:VisualElement>


                                    <ui:VisualElement
                                        class="teacher-info-item">
                                        <ui:Label text="E-Posta" class="teacher-info-caption" />
                                        <ui:Label name="TeacherMailLabel"
                                            text="-"
                                            class="teacher-info-value" />
                                    </ui:VisualElement>

                                    <ui:VisualElement
                                        class="teacher-info-item">
                                        <ui:Label text="Katılım Tarihi" class="teacher-info-caption" />
                                        <ui:Label name="TeacherJoinDateLabel" text="-"
                                            class="teacher-info-value" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="teacher-info-item">
                                        <ui:Label text="Son Giriş" class="teacher-info-caption" />
                                        <ui:Label name="TeacherLastLoginLabel" text="-"
                                            class="teacher-info-value" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="teacher-profile-card teacher-stats-section">
                                <ui:Label text="Genel İstatistikler" class="teacher-section-title" />

                                <ui:VisualElement class="teacher-stats-grid">

                                    <ui:VisualElement class="teacher-stat-card">
                                        <ui:Label text="0" class="stat-value" />
                                        <ui:Label text="Tamamlanan Deney" class="stat-label" />
                                        <ui:Label text="-" class="stat-change" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="teacher-stat-card">
                                        <ui:Label text="0" class="stat-value" />
                                        <ui:Label text="Tamamlanan İş" class="stat-label" />
                                        <ui:Label text="-" class="stat-change" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="teacher-stat-card">
                                        <ui:Label text="%0" class="stat-value" />
                                        <ui:Label text="Devam Oranı" class="stat-label" />
                                        <ui:Label text="-" class="stat-change" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="teacher-stat-card">
                                        <ui:Label text="0" class="stat-value" />
                                        <ui:Label text="Aktif Gün Serisi" class="stat-label" />
                                        <ui:Label text="-" class="stat-change" />
                                    </ui:VisualElement>

                                    <ui:VisualElement class="teacher-stat-card">
                                        <ui:Label text="0" class="stat-value" />
                                        <ui:Label text="Aktif Toplam Gün" class="stat-label" />
                                        <ui:Label text="-" class="stat-change" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="teacher-profile-card teacher-quick-section">
                                <ui:Label text="Hızlı İşlemler" class="teacher-section-title" />

                                <ui:VisualElement class="teacher-quick-actions">
                                    <ui:Button name=""
                                        text="Anasayfaya Git"
                                        class="teacher-quick-btn teacher-quick-btn-primary" />
                                    <ui:Button name="TeacherGoClassesBtn" text="Sınıflarıma Git"
                                        class="teacher-quick-btn" />
                                    <ui:Button name="TeacherLogoutBtn" text="Oturumu Kapat"
                                        class="teacher-quick-btn teacher-quick-btn-danger" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                        </ui:VisualElement>
                    </ui:ScrollView>

                </ui:VisualElement>


                <!-- simülasyon -->
                <ui:VisualElement name="StartSimulationPage" class="page simulation-page">

                    <!-- arka plan -->
                    <ui:Image name="SimulationBg" class="sim-bg" />

                    <!-- içerik -->
                    <ui:VisualElement class="sim-container">
                        <ui:VisualElement class="sim-box">

                            <ui:VisualElement name="SimulationLogo" class="sim-logo" />
                            <ui:Label text="Scienyx" class="sim-title" />

                            <ui:Button name="GoSimulationBtn" class="sim-btn"
                                text="Simülasyonu Başlat" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

                <ui:VisualElement name="SettingsModal" class="modal-backdrop hidden">
                    <ui:VisualElement class="modal settings-modal-card">
                        <ui:VisualElement class="modal-header">
                            <ui:Label text="Hesap Ayarları" />
                            <ui:Button name="SettingsModalCloseBtn" class="modal-close" text="×" />
                        </ui:VisualElement>

                        <ui:ScrollView class="modal-body settings-modal-body" mode="Vertical">
                            <ui:Label text="Profil Bilgileri" class="settings-section-title" />

                            <ui:VisualElement class="settings-grid">
                                <ui:VisualElement class="form-row settings-form-row">
                                    <ui:Label text="Ad" />
                                    <ui:TextField name="SettingsNameInput" />
                                </ui:VisualElement>

                                <ui:VisualElement class="form-row settings-form-row">
                                    <ui:Label text="Soyad" />
                                    <ui:TextField name="SettingsSurnameInput" />
                                </ui:VisualElement>

                                <ui:VisualElement class="form-row settings-form-row settings-form-row-wide">
                                    <ui:Label text="E-Posta" />
                                    <ui:TextField name="SettingsEmailInput" />
                                </ui:VisualElement>

                                <ui:VisualElement class="form-row settings-form-row settings-form-row-wide">
                                    <ui:Label text="Telefon (opsiyonel)" />
                                    <ui:TextField name="SettingsPhoneInput" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:Label name="SettingsStatusLabel" text="" class="settings-status-label hidden" />
                        </ui:ScrollView>

                        <ui:VisualElement class="modal-footer">
                            <ui:Button name="SettingsCancelBtn" class="btn-secondary" text="Kapat" />
                            <ui:Button name="SettingsSaveProfileBtn" class="btn-primary" text="Profili Kaydet" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>