  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b400c73cae759141952f2d3a4056940, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StepAudioPlayer
  audioSource: {fileID: 1519772197}
  subtitleText: {fileID: 559246104}
  continueButton: {fileID: 105514530}
  subtitles:
  - text: "Merhaba, G\xFCne\u015F, D\xFCnya ve Ay\u2019\u0131n hareketlerini inceleyece\u011Fimiz
      tutulma sim\xFClasyonuna haz\u0131r m\u0131s\u0131n\u0131z?"
    startTime: 0
    endTime: 6
  - text: "Bu deneyde, G\xFCne\u015F tutulmas\u0131 ve Ay tutulmas\u0131n\u0131n
      nas\u0131l olu\u015Ftu\u011Funu g\xF6zlemleyece\u011Fiz."
    startTime: 7
    endTime: 13
  - text: "G\xFCne\u015F, D\xFCnya ve Ay\u2019\u0131n konumlar\u0131 de\u011Fi\u015Ftik\xE7e
      g\xF6lgelerin nas\u0131l olu\u015Ftu\u011Funu"
    startTime: 14
    endTime: 18
  - text: "ve bu g\xF6lgelerin tutulmalara nas\u0131l sebep oldu\u011Funu birlikte
      g\xF6rece\u011Fiz.\r\n"
    startTime: 18
    endTime: 23
  - text: "Haz\u0131rsan\u0131z, ilk olarak G\xFCne\u015F tutulmas\u0131n\u0131 inceleyelim."
    startTime: 24
    endTime: 28
